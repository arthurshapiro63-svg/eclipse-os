post_install() {
  systemd-sysusers arclight.conf 2>/dev/null
  systemd-tmpfiles --create arclight.conf 2>/dev/null
  modprobe uinput 2>/dev/null
  udevadm control --reload 2>/dev/null; udevadm trigger --name-match=uinput 2>/dev/null
  # every admin (wheel) user gets the AI interface; the installer does this too
  for u in $(getent group wheel | cut -d: -f4 | tr , ' '); do gpasswd -a "$u" arclight >/dev/null 2>&1; done
  systemctl enable --now arclightd.service 2>/dev/null || systemctl enable arclightd.service 2>/dev/null
  systemctl --global enable arclight-watch.service 2>/dev/null
  echo ">>> Arclight core installed. Log out and back in for the 'arclight' group to apply."
}
post_upgrade() {
  systemd-sysusers arclight.conf 2>/dev/null
  systemd-tmpfiles --create arclight.conf 2>/dev/null
  # 0.1.1: logs written by older versions could hold secrets in plain text; mask them and make them 0600
  PYTHONPATH=/usr/lib/arclight python3 -m arclight.redact --scrub /var/log/arclight/actions.jsonl \
    /var/log/arclight/events.jsonl /var/log/arclight/pkgsync.log /var/log/arclight-install.log \
    /home/*/.local/state/arclight/actions.jsonl /home/*/.local/share/eclipse-ai/log/commands.log >/dev/null 2>&1 || true
  # restart later: this upgrade may itself be running inside arclightd (arc update / the AI's pkg.install)
  systemd-run --quiet --on-active=8 --unit="arclightd-restart-$$" systemctl try-restart arclightd.service 2>/dev/null \
    || systemctl try-restart arclightd.service 2>/dev/null
}
pre_remove() {
  systemctl disable --now arclightd.service 2>/dev/null
}
