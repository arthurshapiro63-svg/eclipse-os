#!/usr/bin/env python3
# Eclipse AI: the local AI assistant window (based on Arch AI by Arthur). eclipse-ai --help
import os, sys
_here = os.path.dirname(os.path.realpath(__file__))
for _c in (os.path.join(_here, ".."), "/usr/lib/arclight"):
    if os.path.isdir(os.path.join(_c, "arclight")):
        sys.path.insert(0, os.path.abspath(_c)); break
from arclight.apps.eclipse_ai.app import main
sys.exit(main())
