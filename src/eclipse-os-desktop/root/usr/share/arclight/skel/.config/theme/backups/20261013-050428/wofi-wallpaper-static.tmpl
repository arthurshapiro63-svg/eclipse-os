/* Generated by theme-apply from tokens/midnight-blue.json via templates/wofi-wallpaper-static.tmpl. Edit the template, not this file. */
/* Glass grid for ~/.local/bin/wallpaper-picker (SUPER+W).
   Same glass language as the DMS bar: surface fill at ~0.62 alpha over the ^wofi$ layer
   blur, a 1px hairline with a lighter top edge, a soft near-black shadow, and the accent
   used only for the selection ring. The current wallpaper's thumbnail carries a baked-in
   accent ring (drawn by the picker). Dynamic twin: ~/.config/matugen/templates/wofi-wallpaper.css */
* { font-family: "Inter", "JetBrainsMono Nerd Font", sans-serif; font-size: 12px; }
window {
    background-color: rgba(18,27,50,0.62);
    border: 1px solid rgba(58,78,122,0.55);
    border-top-color: rgba(230,236,250,0.22);
    border-radius: 16px;
}
#outer-box { padding: 18px; }
#input {
    margin: 0 6px 14px 6px; padding: 8px 14px;
    border: 1px solid rgba(42,58,94,0.9);
    border-top-color: rgba(230,236,250,0.12);
    border-radius: 10px;
    background-color: rgba(10,15,30,0.55);
    color: #E6ECFA; caret-color: #2F7CFF;
    box-shadow: none;
}
#input:focus { border-color: rgba(47,124,255,0.85); }
#input image { color: #6B7A9B; }
#scroll, #inner-box { background: transparent; }
#entry {
    margin: 6px; padding: 6px;
    border-radius: 18px;   /* = thumbnail radius 12 + padding 6: concentric corners */
    border: 1px solid rgba(230,236,250,0.06);
    background-color: rgba(29,42,74,0.45);
}
#entry:hover { background-color: rgba(38,53,90,0.60); }
/* #entry IS the GtkFlowBoxChild in wofi. The user gtk.css paints flowboxchild:selected solid
   accent at a higher priority than this file, so wallpaper-picker runs wofi with its own
   XDG_CONFIG_HOME (no gtk-3.0/gtk.css) and the selection below is what shows. */
/* labels stay searchable but are not drawn: the grid is thumbnails only. The negative
   margin cancels the label's natural width so the thumbnail sits centred in its cell. */
#entry #text, #entry #text:selected, #entry:selected #text {
    font-size: 1px; color: transparent; background: transparent;
    margin: 0 -60px 0 0; padding: 0; min-width: 0;
}
#entry #img, #entry:selected #img { margin: 0; background: transparent; }
#entry:selected {
    background-color: rgba(47,124,255,0.18);
    border: 1px solid #2F7CFF;
    box-shadow: 0 0 0 2px rgba(47,124,255,0.30), 0 6px 18px rgba(5,8,16,0.55);
    outline: none;
}
