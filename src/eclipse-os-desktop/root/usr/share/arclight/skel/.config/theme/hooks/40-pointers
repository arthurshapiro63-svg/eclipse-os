#!/usr/bin/env bash
# Point each multi-palette consumer at the static token render ("rice") or, in dynamic
# mode, at the wallpaper-derived matugen render ("midnight-dynamic"). Idempotent.
set -euo pipefail
name=rice; [[ "${THEME_SLUG:-}" == dynamic ]] && name=midnight-dynamic
g="$HOME/.config/ghostty/config"
[[ -f $g ]] && sed -i -E "s|^theme = .*|theme = $name|" "$g"
b="$HOME/.config/btop/btop.conf"
[[ -f $b ]] && sed -i -E "s|^color_theme = .*|color_theme = \"$name\"|" "$b"
for q in qt5ct qt6ct; do
  f="$HOME/.config/$q/$q.conf"
  [[ -f $f ]] && sed -i -E "s|^color_scheme_path=.*|color_scheme_path=$HOME/.config/$q/colors/$name.conf|" "$f"
done
ghostty +validate-config >/dev/null 2>&1 || { echo "ghostty config INVALID after pointer change" >&2; exit 1; }
echo "pointers -> $name"
