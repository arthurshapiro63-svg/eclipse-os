# Generated by theme-apply from tokens/midnight-blue.json via templates/eza-theme.tmpl. Edit the template, not this file.
# Midnight Blue eza theme -- tokens from ~/.config/theme/tokens/midnight-blue.json
# Directories carry the accent; everything else sits in the grey-blue ramp, with
# semantic colours only where they mean something (exec, write bit, git state, root).
colourful: true

filekinds:
  normal:       { foreground: "#A8B6D4", is_bold: false }
  directory:    { foreground: "#2F7CFF", is_bold: true }
  symlink:      { foreground: "#4FC3F7", is_bold: false }
  pipe:         { foreground: "#FFC857", is_bold: false }
  block_device: { foreground: "#FFC857", is_bold: true }
  char_device:  { foreground: "#FFC857", is_bold: false }
  socket:       { foreground: "#9D7CFF", is_bold: false }
  special:      { foreground: "#9D7CFF", is_bold: false }
  executable:   { foreground: "#3FD68C", is_bold: true }
  mount_point:  { foreground: "#5A9BFF", is_bold: true, is_underline: true }

perms:
  user_read:          { foreground: "#A8B6D4", is_bold: false }
  user_write:         { foreground: "#FFC857", is_bold: false }
  user_execute_file:  { foreground: "#3FD68C", is_bold: true, is_underline: false }
  user_execute_other: { foreground: "#3FD68C", is_bold: false }
  group_read:         { foreground: "#6B7A9B", is_bold: false }
  group_write:        { foreground: "#6B7A9B", is_bold: false }
  group_execute:      { foreground: "#6B7A9B", is_bold: false }
  other_read:         { foreground: "#6B7A9B", is_bold: false }
  other_write:        { foreground: "#FF5C6E", is_bold: false }
  other_execute:      { foreground: "#6B7A9B", is_bold: false }
  special_user_file:  { foreground: "#9D7CFF", is_bold: false }
  special_other:      { foreground: "#9D7CFF", is_bold: false }
  attribute:          { foreground: "#6B7A9B", is_bold: false }

size:
  major:       { foreground: "#6B7A9B", is_bold: false }
  minor:       { foreground: "#6B7A9B", is_bold: false }
  number_byte: { foreground: "#6B7A9B", is_bold: false }
  number_kilo: { foreground: "#A8B6D4", is_bold: false }
  number_mega: { foreground: "#4FC3F7", is_bold: false }
  number_giga: { foreground: "#5A9BFF", is_bold: false }
  number_huge: { foreground: "#FFC857", is_bold: false }
  unit_byte:   { foreground: "#6B7A9B", is_bold: false }
  unit_kilo:   { foreground: "#6B7A9B", is_bold: false }
  unit_mega:   { foreground: "#6B7A9B", is_bold: false }
  unit_giga:   { foreground: "#6B7A9B", is_bold: false }
  unit_huge:   { foreground: "#6B7A9B", is_bold: false }

users:
  user_you:    { foreground: "#A8B6D4", is_bold: false }
  user_root:   { foreground: "#FF5C6E", is_bold: false }
  user_other:  { foreground: "#FFC857", is_bold: false }
  group_yours: { foreground: "#6B7A9B", is_bold: false }
  group_other: { foreground: "#6B7A9B", is_bold: false }
  group_root:  { foreground: "#FF5C6E", is_bold: false }

links:
  normal:          { foreground: "#4FC3F7", is_bold: false }
  multi_link_file: { foreground: "#FFC857", is_bold: false }

git:
  new:        { foreground: "#3FD68C", is_bold: false }
  modified:   { foreground: "#FFC857", is_bold: false }
  deleted:    { foreground: "#FF5C6E", is_bold: false }
  renamed:    { foreground: "#4FC3F7", is_bold: false }
  ignored:    { foreground: "#3A4E7A", is_bold: false }
  conflicted: { foreground: "#FF5C6E", is_bold: true }

git_repo:
  branch_main:  { foreground: "#A8B6D4", is_bold: false }
  branch_other: { foreground: "#FFC857", is_bold: false }
  git_clean:    { foreground: "#3FD68C", is_bold: false }
  git_dirty:    { foreground: "#FFC857", is_bold: false }

file_type:
  image:      { foreground: "#9D7CFF", is_bold: false }
  video:      { foreground: "#BDA5FF", is_bold: false }
  music:      { foreground: "#4FC3F7", is_bold: false }
  crypto:     { foreground: "#3FD68C", is_bold: false }
  document:   { foreground: "#E6ECFA", is_bold: false }
  compressed: { foreground: "#FF8A98", is_bold: false }
  temp:       { foreground: "#6B7A9B", is_bold: false }
  compiled:   { foreground: "#6B7A9B", is_bold: false }
  build:      { foreground: "#FFC857", is_underline: true }
  source:     { foreground: "#86DCFF", is_bold: false }

punctuation:         { foreground: "#3A4E7A", is_bold: false }
date:                { foreground: "#6B7A9B", is_bold: false }
inode:               { foreground: "#6B7A9B", is_bold: false }
blocks:              { foreground: "#6B7A9B", is_bold: false }
header:              { foreground: "#E6ECFA", is_underline: true }
octal:               { foreground: "#6B7A9B", is_bold: false }
flags:               { foreground: "#6B7A9B", is_bold: false }
control_char:        { foreground: "#FF5C6E", is_bold: false }
broken_symlink:      { foreground: "#FF5C6E", is_bold: false }
broken_path_overlay: { is_underline: true }
