# Generated by theme-apply from tokens/midnight-blue.json via templates/ghostty-theme.tmpl. Edit the template, not this file.
# Midnight Blue — generated from ~/.config/theme/tokens/midnight-blue.json
# Base, grey-blue text ramp, one saturated accent (#2F7CFF).
# Glass alpha (background-opacity) lives in ~/.config/ghostty/config.

background = #0A0F1E
foreground = #A8B6D4

# The cursor is the ONE accented thing on this surface.
cursor-color = #2F7CFF
cursor-text  = #060A14

# Selection: the accent's dim step, text lifts to text-primary.
selection-background = #1E5BCC
selection-foreground = #E6ECFA

# Search (ctrl+shift+f): candidates in the raised surface, the current hit in warning.
search-background          = #26355A
search-foreground          = #E6ECFA
search-selected-background = #FFC857
search-selected-foreground = #060A14

# Splits: hairline divider, unfocused panes sink toward bg-sunken.
split-divider-color  = #2A3A5E
unfocused-split-fill = #060A14

# --- ANSI 0-7 (normal) ---
palette = 0=#121B32
palette = 1=#FF5C6E
palette = 2=#3FD68C
palette = 3=#FFC857
palette = 4=#2F7CFF
palette = 5=#9D7CFF
palette = 6=#4FC3F7
palette = 7=#A8B6D4

# --- ANSI 8-15 (bright) ---
palette = 8=#3A4E7A
palette = 9=#FF8A98
palette = 10=#6FE5AC
palette = 11=#FFD98A
palette = 12=#5A9BFF
palette = 13=#BDA5FF
palette = 14=#86DCFF
palette = 15=#E6ECFA
