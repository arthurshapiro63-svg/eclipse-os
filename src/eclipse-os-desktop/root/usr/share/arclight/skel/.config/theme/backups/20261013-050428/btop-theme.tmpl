# Generated by theme-apply from tokens/midnight-blue.json via templates/btop-theme.tmpl. Edit the template, not this file.
# Midnight Blue btop theme -- generated from ~/.config/theme/tokens/midnight-blue.json
# main_bg is only used if theme_background = True (btop.conf keeps it False = the
# terminal's glass shows through). Boxes are hairlines; the accent marks hotkeys and
# the process you select; graphs run the glow ramp (tokens glow.*: the wallpaper's blue -> cyan).
theme[main_bg]="#0A0F1E"
theme[main_fg]="#A8B6D4"
theme[title]="#E6ECFA"
theme[hi_fg]="#5A9BFF"
theme[selected_bg]="#1E5BCC"
theme[selected_fg]="#E6ECFA"
theme[inactive_fg]="#6B7A9B"
theme[graph_text]="#6B7A9B"
theme[meter_bg]="#1D2A4A"
theme[proc_misc]="#4FC3F7"

# Box outlines: one hairline weight everywhere, dividers a step quieter.
theme[cpu_box]="#3A4E7A"
theme[mem_box]="#3A4E7A"
theme[net_box]="#3A4E7A"
theme[proc_box]="#3A4E7A"
theme[div_line]="#2A3A5E"

# Temperature is the one semantic ramp: cool -> warning -> error.
theme[temp_start]="#4FC3F7"
theme[temp_mid]="#FFC857"
theme[temp_end]="#FF5C6E"

# CPU / process load: accent-dim -> accent -> glow.high (cyan in Midnight Blue).
theme[cpu_start]="#1E5BCC"
theme[cpu_mid]="#2F7CFF"
theme[cpu_end]="#4FC3F7"
theme[process_start]="#1E5BCC"
theme[process_mid]="#5A9BFF"
theme[process_end]="#86DCFF"

# Memory: quiet grey-blue ramps for free/cached/available, accent for used (error when full).
theme[free_start]="#2A3A5E"
theme[free_mid]="#6B7A9B"
theme[free_end]="#A8B6D4"
theme[cached_start]="#2A3A5E"
theme[cached_mid]="#6B7A9B"
theme[cached_end]="#A8B6D4"
theme[available_start]="#2A3A5E"
theme[available_mid]="#6B7A9B"
theme[available_end]="#A8B6D4"
theme[used_start]="#1E5BCC"
theme[used_mid]="#2F7CFF"
theme[used_end]="#FF5C6E"

# Network: download in the blue ramp, upload in cyan so the two graphs read apart.
theme[download_start]="#1E5BCC"
theme[download_mid]="#2F7CFF"
theme[download_end]="#5A9BFF"
theme[upload_start]="#3A4E7A"
theme[upload_mid]="#4FC3F7"
theme[upload_end]="#86DCFF"

# Process box banners (pause / follow) and the followed process.
theme[proc_pause_bg]="#FFC857"
theme[proc_follow_bg]="#1E5BCC"
theme[proc_banner_bg]="#1D2A4A"
theme[proc_banner_fg]="#E6ECFA"
theme[followed_bg]="#1E5BCC"
theme[followed_fg]="#E6ECFA"
