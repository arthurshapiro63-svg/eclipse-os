# Midnight Blue btop theme -- generated from ~/.config/theme/tokens/midnight-blue.json
# main_bg is only used if theme_background = True (btop.conf keeps it False = transparent).
theme[main_bg]="#0A0F1E"
theme[main_fg]="#A8B6D4"
theme[title]="#E6ECFA"
theme[hi_fg]="#2F7CFF"
theme[selected_bg]="#1D2A4A"
theme[selected_fg]="#E6ECFA"
theme[inactive_fg]="#6B7A9B"
theme[graph_text]="#A8B6D4"
theme[meter_bg]="#1D2A4A"
theme[proc_misc]="#A8B6D4"
theme[cpu_box]="#3A4E7A"
theme[mem_box]="#3A4E7A"
theme[net_box]="#3A4E7A"
theme[proc_box]="#3A4E7A"
theme[div_line]="#2A3A5E"
theme[temp_start]="#4FC3F7"
theme[temp_mid]="#FFC857"
theme[temp_end]="#FF5C6E"
theme[cpu_start]="#1E5BCC"
theme[cpu_mid]="#2F7CFF"
theme[cpu_end]="#5A9BFF"
theme[free_start]="#2A3A5E"
theme[free_mid]="#6B7A9B"
theme[free_end]="#A8B6D4"
theme[cached_start]="#2A3A5E"
theme[cached_mid]="#6B7A9B"
theme[cached_end]="#A8B6D4"
theme[available_start]="#2A3A5E"
theme[available_mid]="#6B7A9B"
theme[available_end]="#A8B6D4"
theme[used_start]="#1E5BCC"
theme[used_mid]="#2F7CFF"
theme[used_end]="#FF5C6E"
