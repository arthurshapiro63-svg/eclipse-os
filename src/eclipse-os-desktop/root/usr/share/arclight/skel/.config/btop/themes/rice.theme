# Generated by theme-apply from tokens/eclipse.json via templates/btop-theme.tmpl. Edit the template, not this file.
# Eclipse btop theme -- generated from ~/.config/theme/tokens/eclipse.json
# main_bg is only used if theme_background = True (btop.conf keeps it False = the
# terminal's glass shows through). Boxes are hairlines; the accent marks hotkeys and
# the process you select; graphs run the glow ramp (tokens glow.*: the wallpaper's blue -> cyan).
theme[main_bg]="#0B0B0D"
theme[main_fg]="#9A958E"
theme[title]="#ECEAE6"
theme[hi_fg]="#EDB98A"
theme[selected_bg]="#6E4F36"
theme[selected_fg]="#ECEAE6"
theme[inactive_fg]="#6A665F"
theme[graph_text]="#6A665F"
theme[meter_bg]="#222327"
theme[proc_misc]="#FFE6B8"

# Box outlines: one hairline weight everywhere, dividers a step quieter.
theme[cpu_box]="#4A4A50"
theme[mem_box]="#4A4A50"
theme[net_box]="#4A4A50"
theme[proc_box]="#4A4A50"
theme[div_line]="#34353A"

# Temperature is the one semantic ramp: cool -> warning -> error.
theme[temp_start]="#FFE6B8"
theme[temp_mid]="#E0B040"
theme[temp_end]="#D42B2B"

# CPU / process load: accent-dim -> accent -> glow.high (cyan in Midnight Blue).
theme[cpu_start]="#6E4F36"
theme[cpu_mid]="#D08A4E"
theme[cpu_end]="#FFE6B8"
theme[process_start]="#6E4F36"
theme[process_mid]="#EDB98A"
theme[process_end]="#FFF6E4"

# Memory: quiet grey-blue ramps for free/cached/available, accent for used (error when full).
theme[free_start]="#34353A"
theme[free_mid]="#6A665F"
theme[free_end]="#9A958E"
theme[cached_start]="#34353A"
theme[cached_mid]="#6A665F"
theme[cached_end]="#9A958E"
theme[available_start]="#34353A"
theme[available_mid]="#6A665F"
theme[available_end]="#9A958E"
theme[used_start]="#6E4F36"
theme[used_mid]="#D08A4E"
theme[used_end]="#D42B2B"

# Network: download in the blue ramp, upload in cyan so the two graphs read apart.
theme[download_start]="#6E4F36"
theme[download_mid]="#D08A4E"
theme[download_end]="#EDB98A"
theme[upload_start]="#4A4A50"
theme[upload_mid]="#FFE6B8"
theme[upload_end]="#FFF6E4"

# Process box banners (pause / follow) and the followed process.
theme[proc_pause_bg]="#E0B040"
theme[proc_follow_bg]="#6E4F36"
theme[proc_banner_bg]="#222327"
theme[proc_banner_fg]="#ECEAE6"
theme[followed_bg]="#6E4F36"
theme[followed_fg]="#ECEAE6"
