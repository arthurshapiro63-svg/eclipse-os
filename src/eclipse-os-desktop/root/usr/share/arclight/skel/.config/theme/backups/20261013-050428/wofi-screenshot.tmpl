/* Generated by theme-apply from tokens/midnight-blue.json via templates/wofi-screenshot.tmpl. Edit the template, not this file. */
/* Glass capture menu for `shot menu` (SUPER+Print). Same language as the launcher (wofi-style.tmpl).
   Note: `shot theme` would overwrite this file with its own older style; theme-apply owns it now. */
* {
    font-family: "JetBrainsMono Nerd Font", "Inter", monospace;
    font-size: 14px;
}
window {
    background-color: rgba(18,27,50,0.62);
    border: 1px solid rgba(58,78,122,0.55);
    border-top-color: rgba(230,236,250,0.22);
    border-radius: 16px;
}
#outer-box { padding: 10px; }
#input {
    margin-bottom: 8px;
    padding: 6px 10px;
    border: 1px solid rgba(42,58,94,0.9);
    border-top-color: rgba(230,236,250,0.12);
    border-radius: 10px;
    background-color: rgba(10,15,30,0.55);
    color: #E6ECFA;
    caret-color: #2F7CFF;
    box-shadow: none;
}
#input:focus { border-color: rgba(47,124,255,0.85); }
#input image { color: #6B7A9B; }
#scroll, #inner-box { background: transparent; }
#entry {
    padding: 8px 12px;
    border: 1px solid transparent;
    border-radius: 10px;
    background-color: transparent;
    color: #A8B6D4;
}
#entry #text { color: #A8B6D4; }
#entry:hover { background-color: rgba(38,53,90,0.60); }
#entry:selected {
    background-color: rgba(47,124,255,0.18);
    border-color: #2F7CFF;
    outline: none;
}
#entry:selected #text { color: #E6ECFA; }
