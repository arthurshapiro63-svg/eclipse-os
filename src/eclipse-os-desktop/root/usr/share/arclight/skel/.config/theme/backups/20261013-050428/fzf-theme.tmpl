--color=gutter:-1,query:#E6ECFA,disabled:#6B7A9B
--color=info:#6B7A9B,prompt:#2F7CFF,pointer:#2F7CFF
--color=marker:#3FD68C,spinner:#4FC3F7,header:#6B7A9B
--color=border:#3A4E7A,separator:#2A3A5E,scrollbar:#3A4E7A
--color=preview-border:#2A3A5E,label:#A8B6D4,preview-label:#6B7A9B
--border=rounded
--layout=reverse
--height=60%
--margin=0,1
--padding=0,1
--info=inline-right
--prompt='❯ '
--pointer=▌
--marker=▍
--separator=─
--scrollbar=│
--preview-window=right,55%,border-left
