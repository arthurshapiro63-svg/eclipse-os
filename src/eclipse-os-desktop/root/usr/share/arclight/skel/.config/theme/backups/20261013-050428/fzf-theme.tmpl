# Generated by theme-apply from tokens/midnight-blue.json via templates/fzf-theme.tmpl. Edit the template, not this file.
# Midnight Blue fzf options -- tokens from ~/.config/theme/tokens/midnight-blue.json
# Read on every fzf run via FZF_DEFAULT_OPTS_FILE (set in ~/.bashrc), so a theme switch
# reaches already-open shells. bg:-1 keeps the list on the terminal's glass.
--color=fg:#A8B6D4,bg:-1,hl:#4FC3F7
