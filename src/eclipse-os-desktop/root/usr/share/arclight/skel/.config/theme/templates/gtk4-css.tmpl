#@ target: ~/.config/gtk-4.0/gtk.css
#@ comment: /*
/* {{meta.name}} liquid glass for libadwaita / GTK4. Rendered by theme-apply; edit the template.
   Surfaces are translucent and every window asks the compositor for backdrop blur (GTK 4.24 requests
   NO blur over ext-background-effect unless CSS sets backdrop-filter). Selection, focus, switches,
   sliders and progress use the theme's sun colour (Eclipse: the golden corona). */
@define-color accent_color {{sun.gold-soft}};
@define-color accent_bg_color {{sun.gold}};
@define-color accent_fg_color {{sun.on}};
@define-color destructive_color {{color.error}};
@define-color destructive_bg_color {{color.error}};
@define-color destructive_fg_color white;
@define-color error_color {{color.error}};
@define-color error_bg_color {{color.error}};
@define-color error_fg_color white;
@define-color warning_color {{color.warning}};
@define-color warning_bg_color {{color.warning}};
@define-color warning_fg_color rgba(0,0,0,0.8);
@define-color success_color {{color.success}};
@define-color success_bg_color {{color.success}};
@define-color success_fg_color white;
@define-color window_bg_color rgba({{color.bg-base|rgb}},0.78);
@define-color window_fg_color {{color.text-primary}};
@define-color view_bg_color rgba({{color.bg-sunken|rgb}},0.42);
@define-color view_fg_color {{color.text-primary}};
@define-color headerbar_bg_color rgba({{color.surface|rgb}},0.55);
@define-color headerbar_fg_color {{color.text-primary}};
@define-color headerbar_backdrop_color rgba({{color.surface|rgb}},0.48);
@define-color headerbar_border_color {{color.border-subtle}};
@define-color headerbar_shade_color rgba({{color.shadow|rgb}},0.36);
@define-color headerbar_darker_shade_color rgba({{color.shadow|rgb}},0.9);
@define-color sidebar_bg_color rgba({{color.surface|rgb}},0.46);
@define-color sidebar_fg_color {{color.text-primary}};
@define-color sidebar_backdrop_color rgba({{color.surface|rgb}},0.42);
@define-color sidebar_border_color {{color.border-subtle}};
@define-color sidebar_shade_color rgba({{color.shadow|rgb}},0.25);
@define-color card_bg_color rgba({{color.surface-raised|rgb}},0.52);
@define-color card_fg_color {{color.text-primary}};
@define-color card_shade_color rgba({{color.shadow|rgb}},0.36);
@define-color popover_bg_color rgba({{color.surface|rgb}},0.96);
@define-color popover_fg_color {{color.text-primary}};
@define-color popover_shade_color rgba({{color.shadow|rgb}},0.25);
@define-color dialog_bg_color rgba({{color.surface|rgb}},0.90);
@define-color dialog_fg_color {{color.text-primary}};
@define-color thumbnail_bg_color {{color.surface-raised}};
@define-color thumbnail_fg_color {{color.text-primary}};
@define-color shade_color rgba({{color.shadow|rgb}},0.36);
@define-color scrollbar_outline_color rgba({{color.shadow|rgb}},0.5);
@define-color borders {{color.border-subtle}};
@define-color unfocused_borders @borders;
@define-color theme_bg_color @window_bg_color;
@define-color theme_fg_color @window_fg_color;
@define-color theme_base_color @view_bg_color;
@define-color theme_text_color @view_fg_color;
@define-color theme_selected_bg_color @accent_bg_color;
@define-color theme_selected_fg_color @accent_fg_color;
@define-color theme_unfocused_bg_color @window_bg_color;
@define-color theme_unfocused_fg_color @window_fg_color;
@define-color theme_unfocused_base_color @view_bg_color;
@define-color theme_unfocused_text_color @view_fg_color;
@define-color theme_unfocused_selected_bg_color @accent_bg_color;
@define-color theme_unfocused_selected_fg_color @accent_fg_color;
@define-color insensitive_fg_color {{color.text-muted}};
@define-color insensitive_bg_color @window_bg_color;
@define-color insensitive_base_color @view_bg_color;
@define-color unfocused_insensitive_color @insensitive_fg_color;
@define-color secondary_sidebar_bg_color rgba({{color.surface|rgb}},0.46);
@define-color secondary_sidebar_fg_color {{color.text-primary}};
@define-color secondary_sidebar_backdrop_color {{color.surface}};
@define-color secondary_sidebar_border_color {{color.border-subtle}};
@define-color secondary_sidebar_shade_color rgba({{color.shadow|rgb}},0.25);

/* Pin standalone accents and the colours without legacy aliases. */
:root {
  --accent-color: @accent_color;
  --destructive-color: @destructive_color;
  --error-color: @error_color;
  --warning-color: @warning_color;
  --success-color: @success_color;
  --border-color: @borders;
  --active-toggle-bg-color: {{color.accent-dim}};
  --active-toggle-fg-color: white;
  --accent-bg-color: {{sun.gold}};
  --accent-fg-color: {{sun.on}};
  --overview-bg-color: @window_bg_color;
  --overview-fg-color: @window_fg_color;
}

/* Glass foundations: translucent, frosted by the compositor, a bright 1px top edge. */
window.background {
  background-color: @window_bg_color;
  background-image: none;
  color: @window_fg_color;
}
/* every toplevel (Ghostty's window has no .background class), popover and tooltip asks for blur */
window, popover > contents, popover > arrow, tooltip { backdrop-filter: blur(24px); }
window.dialog, window.dialog.filechooser, dialog sheet {
  background-color: @dialog_bg_color;
  color: @dialog_fg_color;
}
list > row.activatable:hover:not(:selected),
listview > row.activatable:hover:not(:selected),
gridview > child.activatable:hover:not(:selected) {
  background-color: {{color.surface-hover}};
}
.view:selected, treeview:selected, iconview:selected,
list > row:selected, listview > row:selected,
gridview > child:selected, flowboxchild:selected {
  background-color: rgba({{color.accent-dim|rgb}},0.62);
  background-image: none;
  box-shadow: inset 0 0 0 1px rgba({{sun.gold|rgb}},0.55);
  color: @window_fg_color;
}
selection {
  background-color: rgba({{sun.gold|rgb}},0.32);
  color: {{color.text-primary}};
}

/* Inline pickers (AdwComboRow, GtkDropDown) and popover lists stay unpainted; libadwaita marks the current item with a check. */
listview.inline, listview.inline > row, listview.inline > row:selected,
listview.inline > row.activatable:hover:not(:selected),
popover listview > row:selected, popover list > row:selected {
  background-color: transparent;
  color: inherit;
}

/* ToolbarView owns the outer hairline of a stack of top bars. */
headerbar, menubar, searchbar, actionbar,
toolbarview > .top-bar, toolbarview > .bottom-bar {
  background-color: @headerbar_bg_color;
  background-image: none;
  color: @headerbar_fg_color;
  border-bottom: {{geometry.hairline}}px solid @borders;
  box-shadow: inset 0 1px rgba({{color.text-primary|rgb}},0.06);
}
headerbar:backdrop, toolbarview > .top-bar:backdrop,
toolbarview > .bottom-bar:backdrop {
  background-color: @headerbar_backdrop_color;
  color: @headerbar_fg_color;
}
toolbarview > .top-bar headerbar, toolbarview > .bottom-bar headerbar,
toolbarview > .top-bar .toolbar, toolbarview > .bottom-bar .toolbar,
toolbarview > .top-bar menubar, toolbarview > .bottom-bar menubar {
  background-color: @headerbar_bg_color;
  border: none;
  box-shadow: none;
}
searchbar > revealer > box, actionbar > revealer > box {
  background-color: @headerbar_bg_color;
  background-image: none;
  border: none;
  box-shadow: none;
}
toolbarview > .bottom-bar {
  border-bottom-width: 0;
  border-top: {{geometry.hairline}}px solid @borders;
}

/* Sidebars and file chooser places. */
.sidebar, .navigation-sidebar, .sidebar-pane, placessidebar,
.sidebar list, .sidebar listview, .sidebar-pane list,
.sidebar-pane listview, placessidebar list {
  background-color: @sidebar_bg_color;
  background-image: none;
  color: @sidebar_fg_color;
}
.sidebar, .navigation-sidebar, placessidebar {
  border-right: {{geometry.hairline}}px solid @sidebar_border_color;
}
.sidebar:dir(rtl), .navigation-sidebar:dir(rtl), placessidebar:dir(rtl) {
  border-right-width: 0;
  border-left: {{geometry.hairline}}px solid @sidebar_border_color;
}
.sidebar .navigation-sidebar, .sidebar-pane .navigation-sidebar,
placessidebar .navigation-sidebar {
  border-width: 0;
}
.sidebar-pane {
  box-shadow: inset -1px 0 @sidebar_border_color;
}
.sidebar-pane:dir(rtl), .sidebar-pane.end:dir(ltr) {
  box-shadow: inset 1px 0 @sidebar_border_color;
}
.sidebar-pane.end:dir(rtl) {
  box-shadow: inset -1px 0 @sidebar_border_color;
}
.sidebar row, .navigation-sidebar row, placessidebar row {
  border-radius: {{geometry.radius-sm}}px;
}
.sidebar row.activatable:hover:not(:selected),
.navigation-sidebar row.activatable:hover:not(:selected),
.sidebar-pane row.activatable:hover:not(:selected),
placessidebar row.activatable:hover:not(:selected) {
  background-color: {{color.surface-hover}};
}
.sidebar row:selected, .navigation-sidebar row:selected,
.sidebar-pane row:selected, placessidebar row:selected,
treeview.navigation-sidebar:selected {
  background-color: rgba({{color.accent-dim|rgb}},0.62);
  background-image: none;
  box-shadow: inset 0 0 0 1px rgba({{sun.gold|rgb}},0.55), 0 0 10px rgba({{sun.gold|rgb}},0.16);
  color: @sidebar_fg_color;
}

/* Cards, including preferences groups and separately boxed rows. */
.card, list.boxed-list, list.boxed-list-separate > row {
  background-color: @card_bg_color;
  background-image: none;
  color: @card_fg_color;
  border: {{geometry.hairline}}px solid @borders;
  border-top-color: rgba({{color.text-primary|rgb}},0.16);
  border-radius: {{geometry.radius-md}}px;
}
.card list {
  background-color: @card_bg_color;
}
list.boxed-list-separate {
  background-color: transparent;
}
list.boxed-list > row:hover:not(:selected),
list.boxed-list-separate > row:hover:not(:selected),
.card row:hover:not(:selected) {
  background-color: {{color.surface-hover}};
}
list.boxed-list-separate > row:selected {
  background-color: @accent_bg_color;
  color: @accent_fg_color;
}

/* Ordinary labelled/raised buttons; native icon controls keep their layout. */
button.text-button, button.raised {
  background-color: @card_bg_color;
  background-image: none;
  color: @window_fg_color;
  box-shadow: inset 0 {{geometry.hairline}}px rgba({{color.text-primary|rgb}},0.06);
}
/* libadwaita keeps bar buttons flat unless raised or suggested. */
headerbar button.text-button:not(.suggested-action):not(.destructive-action):not(.raised):not(:hover):not(:active):not(:checked),
.toolbar button.text-button:not(.suggested-action):not(.destructive-action):not(.raised):not(:hover):not(:active):not(:checked),
actionbar button.text-button:not(.suggested-action):not(.destructive-action):not(.raised):not(:hover):not(:active):not(:checked),
searchbar button.text-button:not(.suggested-action):not(.destructive-action):not(.raised):not(:hover):not(:active):not(:checked) {
  background-color: transparent;
  box-shadow: none;
}
button.flat, menubutton.flat > button {
  background-color: transparent;
  background-image: none;
  border-color: transparent;
  box-shadow: none;
}
button.text-button:hover, button.raised:hover,
button.flat:hover, menubutton.flat > button:hover {
  background-color: {{color.surface-hover}};
}
button.text-button:active, button.raised:active {
  background-color: {{color.accent-dim}};
  color: white;
}
/* Toggled state is neutral; accent stays for selection and suggested actions. */
button.text-button:checked, button.raised:checked, button.flat:checked, button.toggle:checked {
  background-color: {{color.surface-hover}};
  color: @window_fg_color;
}
button.suggested-action {
  background-color: @accent_bg_color;
  background-image: none;
  border-color: @accent_bg_color;
  color: @accent_fg_color;
}
button.suggested-action:hover {
  background-color: {{sun.gold-soft}};
  border-color: {{sun.gold-soft}};
  box-shadow: 0 0 12px rgba({{sun.gold|rgb}},0.35);
}
button.suggested-action:active, button.suggested-action:checked {
  background-color: {{sun.gold-deep}};
  border-color: {{sun.gold-deep}};
  color: @accent_fg_color;
}
button.destructive-action {
  background-color: @destructive_bg_color;
  background-image: none;
  border-color: @destructive_bg_color;
  color: @destructive_fg_color;
}
button.destructive-action:hover {
  background-color: mix(@destructive_bg_color,white,0.12);
}
button.destructive-action:active, button.destructive-action:checked {
  background-color: mix(@destructive_bg_color,{{color.shadow}},0.18);
  color: @destructive_fg_color;
}
button.circular, button.pill {
  border-radius: {{geometry.radius-pill}}px;
}

/* Entries, placeholders and focus follow the GTK4 text node. */
entry, spinbutton {
  background-color: @view_bg_color;
  background-image: none;
  color: @view_fg_color;
  box-shadow: inset 0 0 0 {{geometry.hairline}}px @borders;
}
entry > text, spinbutton > text {
  color: @view_fg_color;
  caret-color: @view_fg_color;
}
entry > text > placeholder, spinbutton > text > placeholder {
  color: {{color.text-muted}};
  opacity: 1;
}
:focus-visible {
  outline-color: rgba({{sun.gold|rgb}},0.70);
}
button:focus-visible, row:focus-visible, checkbutton:focus-visible,
switch:focus-visible, scale:focus-visible,
entry:focus-within, spinbutton:focus-within {
  outline: 2px solid rgba({{sun.gold|rgb}},0.70);
  outline-offset: -2px;
}

/* Retain native indicator glyphs and control geometry. */
check, radio {
  background-color: @card_bg_color;
  background-image: none;
  box-shadow: inset 0 0 0 {{geometry.border-width}}px {{color.border-strong}};
  color: @window_fg_color;
}
switch {
  background-color: {{color.surface-hover}};
  background-image: none;
  color: @window_fg_color;
}
check:checked, check:indeterminate,
radio:checked, radio:indeterminate, switch:checked {
  background-color: @accent_bg_color;
  box-shadow: none;
  color: @accent_fg_color;
}
switch > slider {
  background-color: {{color.text-primary}};
  background-image: none;
}
scale trough, progressbar trough {
  background-color: @card_bg_color;
  background-image: none;
}
scale highlight, progressbar progress {
  background-color: @accent_bg_color;
  background-image: linear-gradient(to right, {{sun.gold-deep}}, {{sun.gold}});
  border-color: @accent_bg_color;
  box-shadow: 0 0 8px rgba({{sun.gold|rgb}},0.35);
}
scale slider {
  background-color: {{color.text-primary}};
  background-image: none;
}

/* Keep overlay visibility and transitions under GTK's control. */
scrollbar, scrollbar trough {
  background-color: transparent;
  background-image: none;
  border-color: transparent;
  box-shadow: none;
}
scrollbar slider {
  background-color: rgba({{color.text-muted|rgb}},0.35);
  background-image: none;
  border-color: transparent;
  border-radius: {{geometry.radius-pill}}px;
  box-shadow: none;
}
scrollbar slider:hover, scrollbar slider:active {
  background-color: rgba({{color.text-muted|rgb}},0.6);
}

/* Paint contents and arrow alike; leave the popover wrapper unpainted. */
popover > contents {
  background-color: @popover_bg_color;
  background-image: none;
  color: @popover_fg_color;
  border: {{geometry.hairline}}px solid @borders;
  border-radius: {{geometry.radius-md}}px;
  box-shadow: 0 4px 16px rgba({{color.shadow|rgb}},0.55);
}
popover > arrow {
  background-color: @popover_bg_color;
  background-image: none;
  border-color: @borders;
  box-shadow: 0 4px 16px rgba({{color.shadow|rgb}},0.55);
}
popover list, popover .view, popover listview {
  background-color: transparent;
}
popover.menu modelbutton, menubar > item {
  color: @popover_fg_color;
  border-radius: {{geometry.radius-sm}}px;
}
popover.menu modelbutton:hover, popover.menu modelbutton:selected,
popover.menu modelbutton:active,
menubar > item:hover, menubar > item:selected {
  background-color: {{color.surface-hover}};
  background-image: none;
  color: @popover_fg_color;
}
popover separator {
  background-color: @borders;
  border-color: @borders;
  min-height: {{geometry.hairline}}px;
}

/* Secondary and insensitive text; primary labels inherit. */
.dim-label, .subtitle, .sidebar .heading,
.navigation-sidebar .heading, placessidebar .heading {
  color: {{color.text-secondary}};
  opacity: 1;
}
:link, button:link {
  color: {{sun.gold-soft}};
}
:visited, button:visited {
  color: {{ansi.magenta}};
}
button:link, button:visited {
  background-color: transparent;
  background-image: none;
  border-color: transparent;
  box-shadow: none;
}
tooltip, tooltip.background {
  background-color: rgba({{color.surface-raised|rgb}},0.92);
  background-image: none;
  color: @window_fg_color;
  border: {{geometry.hairline}}px solid rgba({{color.border-strong|rgb}},0.6);
  border-radius: {{geometry.radius-sm}}px;
  box-shadow: none;
}
tooltip label {
  color: @window_fg_color;
}
