#@ target: ~/.config/quickshell/arthur/colors.json
#@ comment: none
{
  "source": "theme-apply {{meta.slug}}",
  "color": {
    "bg-sunken": "{{color.bg-sunken}}",
    "bg-base": "{{color.bg-base}}",
    "surface": "{{color.surface}}",
    "surface-raised": "{{color.surface-raised}}",
    "surface-hover": "{{color.surface-hover}}",
    "border-subtle": "{{color.border-subtle}}",
    "border-strong": "{{color.border-strong}}",
    "text-primary": "{{color.text-primary}}",
    "text-secondary": "{{color.text-secondary}}",
    "text-muted": "{{color.text-muted}}",
    "accent": "{{sun.gold}}",
    "moon": "{{color.accent}}",
    "accent-bright": "{{sun.gold-soft}}",
    "accent-dim": "{{color.accent-dim}}",
    "success": "{{color.success}}",
    "warning": "{{color.warning}}",
    "error": "{{color.error}}",
    "shadow": "{{color.shadow}}"
  },
  "alpha": {
    "shell-bar": {{alpha.shell-bar}},
    "shell-panel": {{alpha.shell-panel}},
    "shell-card": {{alpha.shell-card}}
  }
}
