#@ target: ~/.config/starship.toml
#@ comment: #
# {{meta.name}} — Starship prompt
# Palette values from ~/.config/theme/tokens/{{meta.slug}}.json
# Accent discipline: the directory and the prompt character are the ONLY accented
# elements; everything else sits in the grey-blue ramp, with semantic colours only
# for state (git dirty/staged/conflict, failed command).

"$schema" = 'https://starship.rs/config-schema.json'

add_newline = true
palette = "rice"

# line 1: [user@host over ssh] directory, git, language (inside projects), jobs, duration, exit code
# line 2: the prompt character
format = """
$username\
$hostname\
$directory\
$git_branch\
$git_state\
$git_status\
$python\
$nodejs\
$rust\
$golang\
$zig\
$bun\
$deno\
$jobs\
$cmd_duration\
$status\
$line_break\
$character"""

[palettes.rice]
accent         = "#{{color.accent|hex}}"
accent_bright  = "#{{color.accent-bright|hex}}"
sun            = "#{{sun.gold|hex}}"
text_primary   = "#{{color.text-primary|hex}}"
text_secondary = "#{{color.text-secondary|hex}}"
text_muted     = "#{{color.text-muted|hex}}"
border_strong  = "#{{color.border-strong|hex}}"
success        = "#{{color.success|hex}}"
warning        = "#{{color.warning|hex}}"
error          = "#{{color.error|hex}}"

# Only shown over ssh or as root.
[username]
style_user = "text_secondary"
style_root = "bold error"
format = "[$user]($style)[@](text_muted)"

[hostname]
ssh_only = true
ssh_symbol = ""
style = "text_secondary"
format = "[$hostname]($style) [in](text_muted) "

[directory]
style = "bold accent"
read_only = " 󰌾"
read_only_style = "text_muted"
truncation_length = 4
truncation_symbol = "…/"
truncate_to_repo = false
home_symbol = "~"
format = "[$path]($style)[$read_only]($read_only_style) "

[git_branch]
symbol = " "
style = "text_secondary"
format = "[on](text_muted) [$symbol$branch(:$remote_branch)]($style) "

[git_state]
style = "warning"
format = '[\($state( $progress_current/$progress_total)\)]($style) '

# Each state carries its own semantic colour: staged = success, changed = warning,
# conflict = error; untracked/stash/ahead/behind stay in the grey ramp.
[git_status]
style = "text_muted"
format = '([$all_status$ahead_behind]($style))'
conflicted = "[=$count ](bold error)"
staged     = "[+$count ](success)"
modified   = "[!$count ](warning)"
renamed    = "[»$count ](warning)"
deleted    = "[✘$count ](warning)"
typechanged = ""
untracked  = "[?$count ](text_muted)"
stashed    = "[≡ ](text_muted)"
ahead      = "[⇡$count ](text_secondary)"
behind     = "[⇣$count ](text_secondary)"
diverged   = "[⇡$ahead_count⇣$behind_count ](text_secondary)"
up_to_date = ""

# Language versions: only inside matching projects, muted, major.minor only.
[python]
symbol = " "
style = "text_muted"
version_format = "${major}.${minor}"
# Only in real projects / venvs: loose *.py files (e.g. ~/arch_cap.py) must not
# put a version on the home prompt.
detect_extensions = []
format = '[$symbol$version( \($virtualenv\))]($style) '

[nodejs]
symbol = " "
style = "text_muted"
version_format = "${major}.${minor}"
format = '[$symbol$version]($style) '

[rust]
symbol = "󱘗 "
style = "text_muted"
version_format = "${major}.${minor}"
format = '[$symbol$version]($style) '

[golang]
symbol = " "
style = "text_muted"
version_format = "${major}.${minor}"
format = '[$symbol$version]($style) '

[zig]
symbol = " "
style = "text_muted"
version_format = "${major}.${minor}"
format = '[$symbol$version]($style) '

[bun]
symbol = " "
style = "text_muted"
version_format = "${major}.${minor}"
format = '[$symbol$version]($style) '

[deno]
symbol = " "
style = "text_muted"
version_format = "${major}.${minor}"
format = '[$symbol$version]($style) '

[jobs]
symbol = "✦"
style = "text_muted"
number_threshold = 1
format = "[$symbol$number]($style) "

[cmd_duration]
min_time = 2000
style = "text_muted"
format = "[󱎫 $duration]($style) "

[status]
disabled = false
symbol = "✘ "
style = "bold error"
format = "[$symbol$status]($style) "
map_symbol = false

[character]
success_symbol = "[❯](bold sun)"
error_symbol   = "[❯](bold error)"
vimcmd_symbol  = "[❮](bold sun)"

[line_break]
disabled = false
