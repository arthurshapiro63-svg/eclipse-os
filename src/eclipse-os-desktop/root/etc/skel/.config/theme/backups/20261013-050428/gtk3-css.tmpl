/* Generated by theme-apply from tokens/midnight-blue.json via templates/gtk3-css.tmpl. Edit the template, not this file. */
/* Midnight Blue glass overrides for adw-gtk3-dark (GTK3). Rendered by theme-apply; edit the template. */
@define-color accent_color #5A9BFF;
@define-color accent_bg_color #2F7CFF;
@define-color accent_fg_color white;
@define-color destructive_color #FF5C6E;
@define-color destructive_bg_color #FF5C6E;
@define-color destructive_fg_color white;
@define-color error_color #FF5C6E;
@define-color error_bg_color #FF5C6E;
@define-color error_fg_color white;
@define-color warning_color #FFC857;
@define-color warning_bg_color #FFC857;
@define-color warning_fg_color rgba(0,0,0,0.8);
@define-color success_color #3FD68C;
@define-color success_bg_color #3FD68C;
@define-color success_fg_color white;
@define-color window_bg_color #0A0F1E;
@define-color window_fg_color #E6ECFA;
@define-color view_bg_color #060A14;
@define-color view_fg_color #E6ECFA;
@define-color headerbar_bg_color #121B32;
@define-color headerbar_fg_color #E6ECFA;
@define-color headerbar_backdrop_color #121B32;
@define-color headerbar_border_color #2A3A5E;
@define-color headerbar_shade_color rgba(5,8,16,0.36);
@define-color headerbar_darker_shade_color rgba(5,8,16,0.9);
@define-color sidebar_bg_color #121B32;
@define-color sidebar_fg_color #E6ECFA;
@define-color sidebar_backdrop_color #121B32;
@define-color sidebar_border_color #2A3A5E;
@define-color sidebar_shade_color rgba(5,8,16,0.25);
@define-color card_bg_color #1D2A4A;
@define-color card_fg_color #E6ECFA;
@define-color card_shade_color rgba(5,8,16,0.36);
@define-color popover_bg_color rgba(18,27,50,0.96);
@define-color popover_fg_color #E6ECFA;
@define-color popover_shade_color rgba(5,8,16,0.25);
@define-color dialog_bg_color #121B32;
@define-color dialog_fg_color #E6ECFA;
@define-color thumbnail_bg_color #1D2A4A;
@define-color thumbnail_fg_color #E6ECFA;
@define-color shade_color rgba(5,8,16,0.36);
@define-color scrollbar_outline_color rgba(5,8,16,0.5);
@define-color borders #2A3A5E;
@define-color unfocused_borders @borders;
@define-color theme_bg_color @window_bg_color;
@define-color theme_fg_color @window_fg_color;
@define-color theme_base_color @view_bg_color;
@define-color theme_text_color @view_fg_color;
@define-color theme_selected_bg_color @accent_bg_color;
@define-color theme_selected_fg_color @accent_fg_color;
@define-color theme_unfocused_bg_color @window_bg_color;
@define-color theme_unfocused_fg_color @window_fg_color;
@define-color theme_unfocused_base_color @view_bg_color;
@define-color theme_unfocused_text_color @view_fg_color;
@define-color theme_unfocused_selected_bg_color @accent_bg_color;
@define-color theme_unfocused_selected_fg_color @accent_fg_color;
@define-color insensitive_fg_color #6B7A9B;
@define-color insensitive_bg_color @window_bg_color;
@define-color insensitive_base_color @view_bg_color;
@define-color unfocused_insensitive_color @insensitive_fg_color;
@define-color content_view_bg @view_bg_color;
@define-color text_view_bg @view_bg_color;
@define-color panel_bg_color @window_bg_color;
@define-color panel_fg_color @window_fg_color;

/* Window fill comes from @window_bg_color via the theme (no USER-priority window rule: it would
   override wofi's own translucent window, whose --style loads at a lower priority than this file).
   #input / #entry are wofi's widget names; they are excluded below for the same reason. */
window.dialog, dialog, messagedialog {
  background-color: @dialog_bg_color;
  color: @dialog_fg_color;
}
list > row.activatable:hover:not(:selected) {
  background-color: #26355A;
}
.view:selected, iconview:selected, treeview:selected,
.view text:selected, iconview text:selected,
list > row:selected, flowboxchild:not(#entry):selected, selection {
  background-color: @accent_bg_color;
  background-image: none;
  color: @accent_fg_color;
}

/* Raised bars retain their fill in backdrop. */
headerbar, menubar, toolbar, searchbar, actionbar {
  background-color: @headerbar_bg_color;
  background-image: none;
  color: @headerbar_fg_color;
  border-bottom: 1px solid @borders;
  box-shadow: inset 0 1px rgba(230,236,250,0.06);
}
headerbar:backdrop, menubar:backdrop, toolbar:backdrop,
searchbar:backdrop, actionbar:backdrop {
  background-color: @headerbar_backdrop_color;
  color: @headerbar_fg_color;
}
searchbar > revealer > box, actionbar > revealer > box {
  background-color: @headerbar_bg_color;
  background-image: none;
  border: none;
  box-shadow: none;
}
statusbar, .thunar statusbar {
  background-color: @headerbar_bg_color;
  color: @headerbar_fg_color;
  border-top: 1px solid @borders;
}

/* Sidebars, including Thunar's tree and GtkFileChooser's places list. */
.sidebar, placessidebar, .shortcuts-pane,
.sidebar treeview, .sidebar list, placessidebar list,
.shortcuts-pane treeview, .thunar .shortcuts-pane {
  background-color: @sidebar_bg_color;
  background-image: none;
  color: @sidebar_fg_color;
}
.sidebar, placessidebar, .shortcuts-pane {
  border-right: 1px solid @sidebar_border_color;
}
.sidebar:dir(rtl), placessidebar:dir(rtl), .shortcuts-pane:dir(rtl) {
  border-right-width: 0;
  border-left: 1px solid @sidebar_border_color;
}
.sidebar row, placessidebar row {
  border-radius: 6px;
}
.sidebar row.activatable:hover:not(:selected),
placessidebar row.activatable:hover:not(:selected) {
  background-color: #26355A;
}
treeview.sidebar:selected, .sidebar treeview:selected,
treeview.shortcuts-pane:selected, .shortcuts-pane treeview:selected,
.sidebar row:selected, placessidebar row:selected {
  background-color: mix(@sidebar_bg_color,@accent_bg_color,0.22);
  background-image: none;
  color: @sidebar_fg_color;
}

/* Breadcrumb containers and location entries use the sunken surface. */
pathbar, .path-bar {
  background-color: @view_bg_color;
  background-image: none;
  color: @view_fg_color;
  border: 1px solid @borders;
  border-radius: 10px;
}

/* adw-gtk3 derives separators and frame lines from currentColor (a neutral grey-navy); use the token hairline. */
separator {
  background-color: @borders;
}
paned > separator {
  background-color: transparent;
  background-image: image(@borders);
}
frame > border, .frame {
  border-color: @borders;
}

/* Cards and boxed preference lists. */
.card, list.boxed-list {
  background-color: @card_bg_color;
  background-image: none;
  color: @card_fg_color;
  border: 1px solid @borders;
  border-radius: 10px;
}
.card list {
  background-color: @card_bg_color;
}
list.boxed-list > row:hover:not(:selected), .card row:hover:not(:selected) {
  background-color: #26355A;
}

/* Buttons: preserve theme dimensions and glyphs. */
button {
  background-color: @card_bg_color;
  background-image: none;
  color: @window_fg_color;
  box-shadow: inset 0 1px rgba(230,236,250,0.06);
}
button.flat, button.titlebutton {
  background-color: transparent;
  border-color: transparent;
  box-shadow: none;
}
button:hover {
  background-color: #26355A;
}
button:active {
  background-color: #1E5BCC;
  color: white;
}
/* Toggled state is neutral, as in libadwaita; accent stays for selection and suggested actions. */
button:checked {
  background-color: #26355A;
  color: @window_fg_color;
}
/* libadwaita keeps bar buttons flat; match it so GTK3 dialogs (portal file chooser) sit beside GTK4 apps. */
headerbar button:not(.suggested-action):not(.destructive-action):not(.titlebutton):not(:hover):not(:active):not(:checked) {
  background-color: transparent;
  box-shadow: none;
}
button.suggested-action {
  background-color: @accent_bg_color;
  border-color: @accent_bg_color;
  color: @accent_fg_color;
}
button.suggested-action:hover {
  background-color: #5A9BFF;
  border-color: #5A9BFF;
}
button.suggested-action:active, button.suggested-action:checked {
  background-color: #1E5BCC;
  border-color: #1E5BCC;
}
button.destructive-action {
  background-color: @destructive_bg_color;
  border-color: @destructive_bg_color;
  color: @destructive_fg_color;
}
button.destructive-action:hover {
  background-color: mix(@destructive_bg_color,white,0.12);
}
button.destructive-action:active {
  background-color: mix(@destructive_bg_color,#050810,0.18);
}
button.circular, button.pill {
  border-radius: 9999px;
}

/* Entries and keyboard focus. */
entry:not(#input), spinbutton:not(.vertical) {
  background-color: @view_bg_color;
  background-image: none;
  color: @view_fg_color;
  caret-color: @view_fg_color;
  border-color: @borders;
}
spinbutton:not(.vertical) entry {
  border-color: transparent;
}
:focus {
  outline-color: rgba(47,124,255,0.65);
}
button:focus, entry:not(#input):focus, spinbutton:focus, row:focus,
checkbutton:focus, radiobutton:focus, switch:focus, scale:focus {
  outline: 2px solid rgba(47,124,255,0.65);
  outline-offset: -2px;
}
entry:not(#input):focus, spinbutton:focus:not(.vertical) {
  border-color: @accent_bg_color;
  box-shadow: inset 0 0 0 1px rgba(47,124,255,0.5);
}

/* Keep native check/radio marks; recolour their existing nodes. */
check, radio, switch {
  background-color: @card_bg_color;
  background-image: none;
  border-color: #3A4E7A;
  color: @window_fg_color;
}
check:checked, check:indeterminate,
radio:checked, radio:indeterminate, switch:checked {
  background-color: @accent_bg_color;
  border-color: @accent_bg_color;
  color: white;
}
switch slider {
  background-color: #E6ECFA;
  background-image: none;
}
scale trough, progressbar trough {
  background-color: @card_bg_color;
  background-image: none;
  border-color: @borders;
}
scale highlight, progressbar progress {
  background-color: @accent_bg_color;
  background-image: none;
  border-color: @accent_bg_color;
}
scale slider {
  background-color: #E6ECFA;
  background-image: none;
}

/* Preserve overlay state, hit areas and theme scrollbar transitions. */
scrollbar, scrollbar trough {
  background-color: transparent;
  background-image: none;
  border-color: transparent;
  box-shadow: none;
}
scrollbar slider {
  background-color: rgba(107,122,155,0.35);
  background-image: none;
  border-color: transparent;
  border-radius: 9999px;
  box-shadow: none;
}
scrollbar slider:hover, scrollbar slider:active {
  background-color: rgba(107,122,155,0.6);
}

/* Notebook underline follows the tab position. */
notebook > header {
  background-color: @headerbar_bg_color;
  background-image: none;
}
notebook > header.top {
  border-bottom: 1px solid @borders;
}
notebook > header tab {
  color: #A8B6D4;
  background-image: none;
}
notebook > header tab:checked {
  color: @window_fg_color;
  background-color: @headerbar_bg_color;
  box-shadow: inset 0 -2px @accent_bg_color;
}
notebook > header.bottom tab:checked { box-shadow: inset 0 2px @accent_bg_color; }
notebook > header.left tab:checked { box-shadow: inset -2px 0 @accent_bg_color; }
notebook > header.right tab:checked { box-shadow: inset 2px 0 @accent_bg_color; }

/* One translucent popup surface; GTK3 draws its own popover arrow. */
popover.background {
  background-color: @popover_bg_color;
  background-image: none;
  color: @popover_fg_color;
  border: 1px solid @borders;
  border-radius: 10px;
  box-shadow: 0 4px 16px rgba(5,8,16,0.55);
}
menu, .menu, .context-menu {
  background-color: @popover_bg_color;
  background-image: none;
  color: @popover_fg_color;
  border-color: @borders;
}
.csd menu, .csd .menu, .csd .context-menu {
  border-radius: 10px;
}
.csd.popup decoration {
  border-radius: 10px;
  box-shadow: 0 4px 12px rgba(5,8,16,0.55),
              0 0 0 1px @borders;
}
popover list {
  background-color: transparent;
}
menuitem, modelbutton {
  color: @popover_fg_color;
  border-radius: 6px;
}
menuitem:hover, menuitem:selected, modelbutton:hover, modelbutton:selected {
  background-color: #26355A;
  background-image: none;
  color: @popover_fg_color;
}
menu separator, popover separator {
  background-color: @borders;
  border-color: @borders;
  min-height: 1px;
}

/* Secondary and insensitive text; primary labels inherit. */
.dim-label, .subtitle, .sidebar .heading, placessidebar .heading {
  color: #A8B6D4;
  opacity: 1;
}
:link, button:link {
  color: #5A9BFF;
}
:visited, button:visited {
  color: #9D7CFF;
}
button:link, button:visited {
  background-color: transparent;
  background-image: none;
  border-color: transparent;
  box-shadow: none;
}
:disabled, label:disabled {
  color: @insensitive_fg_color;
}
button:disabled {
  background-color: @insensitive_bg_color;
  color: @insensitive_fg_color;
}
button.flat:disabled, button.titlebutton:disabled {
  background-color: transparent;
}
entry:disabled, spinbutton:disabled {
  color: @insensitive_fg_color;
}
tooltip, tooltip.background {
  background-color: rgba(29,42,74,0.92);
  background-image: none;
  color: @window_fg_color;
  border: 1px solid rgba(58,78,122,0.6);
  border-radius: 6px;
  box-shadow: none;
}
tooltip label {
  color: @window_fg_color;
}
