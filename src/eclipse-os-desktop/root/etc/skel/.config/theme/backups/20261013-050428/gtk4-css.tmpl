/* Pin standalone accents and the colours without legacy aliases. */
:root {
  --accent-color: @accent_color;
  --destructive-color: @destructive_color;
  --error-color: @error_color;
  --warning-color: @warning_color;
  --success-color: @success_color;
  --border-color: @borders;
  --active-toggle-bg-color: #1E5BCC;
  --active-toggle-fg-color: white;
  --overview-bg-color: @window_bg_color;
  --overview-fg-color: @window_fg_color;
}

/* Opaque foundations; preserve semantic text inheritance. */
window.background {
  background-color: @window_bg_color;
  background-image: none;
  color: @window_fg_color;
}
window.dialog, window.dialog.filechooser, dialog sheet {
  background-color: @dialog_bg_color;
  color: @dialog_fg_color;
}
list > row.activatable:hover:not(:selected),
listview > row.activatable:hover:not(:selected),
gridview > child.activatable:hover:not(:selected) {
  background-color: #26355A;
}
.view:selected, treeview:selected, iconview:selected,
list > row:selected, listview > row:selected,
gridview > child:selected, flowboxchild:selected, selection {
  background-color: @accent_bg_color;
  background-image: none;
  color: @accent_fg_color;
}

/* Inline pickers (AdwComboRow, GtkDropDown) and popover lists stay unpainted; libadwaita marks the current item with a check. */
listview.inline, listview.inline > row, listview.inline > row:selected,
listview.inline > row.activatable:hover:not(:selected),
popover listview > row:selected, popover list > row:selected {
  background-color: transparent;
  color: inherit;
}

/* ToolbarView owns the outer hairline of a stack of top bars. */
headerbar, menubar, searchbar, actionbar,
toolbarview > .top-bar, toolbarview > .bottom-bar {
  background-color: @headerbar_bg_color;
  background-image: none;
  color: @headerbar_fg_color;
  border-bottom: 1px solid @borders;
  box-shadow: inset 0 1px rgba(230,236,250,0.06);
}
headerbar:backdrop, toolbarview > .top-bar:backdrop,
toolbarview > .bottom-bar:backdrop {
  background-color: @headerbar_backdrop_color;
  color: @headerbar_fg_color;
}
toolbarview > .top-bar headerbar, toolbarview > .bottom-bar headerbar,
toolbarview > .top-bar .toolbar, toolbarview > .bottom-bar .toolbar,
toolbarview > .top-bar menubar, toolbarview > .bottom-bar menubar {
  background-color: @headerbar_bg_color;
  border: none;
  box-shadow: none;
}
searchbar > revealer > box, actionbar > revealer > box {
  background-color: @headerbar_bg_color;
  background-image: none;
  border: none;
  box-shadow: none;
}
toolbarview > .bottom-bar {
  border-bottom-width: 0;
  border-top: 1px solid @borders;
}

/* Sidebars and file chooser places. */
.sidebar, .navigation-sidebar, .sidebar-pane, placessidebar,
.sidebar list, .sidebar listview, .sidebar-pane list,
.sidebar-pane listview, placessidebar list {
  background-color: @sidebar_bg_color;
  background-image: none;
  color: @sidebar_fg_color;
}
.sidebar, .navigation-sidebar, placessidebar {
  border-right: 1px solid @sidebar_border_color;
}
.sidebar:dir(rtl), .navigation-sidebar:dir(rtl), placessidebar:dir(rtl) {
  border-right-width: 0;
  border-left: 1px solid @sidebar_border_color;
}
.sidebar .navigation-sidebar, .sidebar-pane .navigation-sidebar,
placessidebar .navigation-sidebar {
  border-width: 0;
}
.sidebar-pane {
  box-shadow: inset -1px 0 @sidebar_border_color;
}
.sidebar-pane:dir(rtl), .sidebar-pane.end:dir(ltr) {
  box-shadow: inset 1px 0 @sidebar_border_color;
}
.sidebar-pane.end:dir(rtl) {
  box-shadow: inset -1px 0 @sidebar_border_color;
}
.sidebar row, .navigation-sidebar row, placessidebar row {
  border-radius: 6px;
}
.sidebar row.activatable:hover:not(:selected),
.navigation-sidebar row.activatable:hover:not(:selected),
.sidebar-pane row.activatable:hover:not(:selected),
placessidebar row.activatable:hover:not(:selected) {
  background-color: #26355A;
}
.sidebar row:selected, .navigation-sidebar row:selected,
.sidebar-pane row:selected, placessidebar row:selected,
treeview.navigation-sidebar:selected {
  background-color: mix(@sidebar_bg_color,@accent_bg_color,0.22);
  background-image: none;
  color: @sidebar_fg_color;
}

/* Cards, including preferences groups and separately boxed rows. */
.card, list.boxed-list, list.boxed-list-separate > row {
  background-color: @card_bg_color;
  background-image: none;
  color: @card_fg_color;
  border: 1px solid @borders;
  border-radius: 10px;
}
.card list {
  background-color: @card_bg_color;
}
list.boxed-list-separate {
  background-color: transparent;
}
list.boxed-list > row:hover:not(:selected),
list.boxed-list-separate > row:hover:not(:selected),
.card row:hover:not(:selected) {
  background-color: #26355A;
}
list.boxed-list-separate > row:selected {
  background-color: @accent_bg_color;
  color: @accent_fg_color;
}

/* Ordinary labelled/raised buttons; native icon controls keep their layout. */
button.text-button, button.raised {
  background-color: @card_bg_color;
  background-image: none;
  color: @window_fg_color;
  box-shadow: inset 0 1px rgba(230,236,250,0.06);
}
/* libadwaita keeps bar buttons flat unless raised or suggested. */
headerbar button.text-button:not(.suggested-action):not(.destructive-action):not(.raised):not(:hover):not(:active):not(:checked),
.toolbar button.text-button:not(.suggested-action):not(.destructive-action):not(.raised):not(:hover):not(:active):not(:checked),
actionbar button.text-button:not(.suggested-action):not(.destructive-action):not(.raised):not(:hover):not(:active):not(:checked),
searchbar button.text-button:not(.suggested-action):not(.destructive-action):not(.raised):not(:hover):not(:active):not(:checked) {
  background-color: transparent;
  box-shadow: none;
}
button.flat, menubutton.flat > button {
  background-color: transparent;
  background-image: none;
  border-color: transparent;
  box-shadow: none;
}
button.text-button:hover, button.raised:hover,
button.flat:hover, menubutton.flat > button:hover {
  background-color: #26355A;
}
button.text-button:active, button.raised:active {
  background-color: #1E5BCC;
  color: white;
}
/* Toggled state is neutral; accent stays for selection and suggested actions. */
button.text-button:checked, button.raised:checked, button.flat:checked, button.toggle:checked {
  background-color: #26355A;
  color: @window_fg_color;
}
button.suggested-action {
  background-color: @accent_bg_color;
  background-image: none;
  border-color: @accent_bg_color;
  color: @accent_fg_color;
}
button.suggested-action:hover {
  background-color: #5A9BFF;
  border-color: #5A9BFF;
}
button.suggested-action:active, button.suggested-action:checked {
  background-color: #1E5BCC;
  border-color: #1E5BCC;
  color: @accent_fg_color;
}
button.destructive-action {
  background-color: @destructive_bg_color;
  background-image: none;
  border-color: @destructive_bg_color;
  color: @destructive_fg_color;
}
button.destructive-action:hover {
  background-color: mix(@destructive_bg_color,white,0.12);
}
button.destructive-action:active, button.destructive-action:checked {
  background-color: mix(@destructive_bg_color,#050810,0.18);
  color: @destructive_fg_color;
}
button.circular, button.pill {
  border-radius: 9999px;
}

/* Entries, placeholders and focus follow the GTK4 text node. */
entry, spinbutton {
  background-color: @view_bg_color;
  background-image: none;
  color: @view_fg_color;
  box-shadow: inset 0 0 0 1px @borders;
}
entry > text, spinbutton > text {
  color: @view_fg_color;
  caret-color: @view_fg_color;
}
entry > text > placeholder, spinbutton > text > placeholder {
  color: #6B7A9B;
  opacity: 1;
}
:focus-visible {
  outline-color: rgba(47,124,255,0.65);
}
button:focus-visible, row:focus-visible, checkbutton:focus-visible,
switch:focus-visible, scale:focus-visible,
entry:focus-within, spinbutton:focus-within {
  outline: 2px solid rgba(47,124,255,0.65);
  outline-offset: -2px;
}

/* Retain native indicator glyphs and control geometry. */
check, radio {
  background-color: @card_bg_color;
  background-image: none;
  box-shadow: inset 0 0 0 2px #3A4E7A;
  color: @window_fg_color;
}
switch {
  background-color: #26355A;
  background-image: none;
  color: @window_fg_color;
}
check:checked, check:indeterminate,
radio:checked, radio:indeterminate, switch:checked {
  background-color: @accent_bg_color;
  box-shadow: none;
  color: white;
}
switch > slider {
  background-color: #E6ECFA;
  background-image: none;
}
scale trough, progressbar trough {
  background-color: @card_bg_color;
  background-image: none;
}
scale highlight, progressbar progress {
  background-color: @accent_bg_color;
  background-image: none;
  border-color: @accent_bg_color;
}
scale slider {
  background-color: #E6ECFA;
  background-image: none;
}

/* Keep overlay visibility and transitions under GTK's control. */
scrollbar, scrollbar trough {
  background-color: transparent;
  background-image: none;
  border-color: transparent;
  box-shadow: none;
}
scrollbar slider {
  background-color: rgba(107,122,155,0.35);
  background-image: none;
  border-color: transparent;
  border-radius: 9999px;
  box-shadow: none;
}
scrollbar slider:hover, scrollbar slider:active {
  background-color: rgba(107,122,155,0.6);
}

/* Paint contents and arrow alike; leave the popover wrapper unpainted. */
popover > contents {
  background-color: @popover_bg_color;
  background-image: none;
  color: @popover_fg_color;
  border: 1px solid @borders;
  border-radius: 10px;
  box-shadow: 0 4px 16px rgba(5,8,16,0.55);
}
popover > arrow {
  background-color: @popover_bg_color;
  background-image: none;
  border-color: @borders;
  box-shadow: 0 4px 16px rgba(5,8,16,0.55);
}
popover list, popover .view, popover listview {
  background-color: transparent;
}
popover.menu modelbutton, menubar > item {
  color: @popover_fg_color;
  border-radius: 6px;
}
popover.menu modelbutton:hover, popover.menu modelbutton:selected,
popover.menu modelbutton:active,
menubar > item:hover, menubar > item:selected {
  background-color: #26355A;
  background-image: none;
  color: @popover_fg_color;
}
popover separator {
  background-color: @borders;
  border-color: @borders;
  min-height: 1px;
}

/* Secondary and insensitive text; primary labels inherit. */
.dim-label, .subtitle, .sidebar .heading,
.navigation-sidebar .heading, placessidebar .heading {
  color: #A8B6D4;
  opacity: 1;
}
:link, button:link {
  color: #5A9BFF;
}
:visited, button:visited {
  color: #9D7CFF;
}
button:link, button:visited {
  background-color: transparent;
  background-image: none;
  border-color: transparent;
  box-shadow: none;
}
tooltip, tooltip.background {
  background-color: rgba(29,42,74,0.92);
  background-image: none;
  color: @window_fg_color;
  border: 1px solid rgba(58,78,122,0.6);
  border-radius: 6px;
  box-shadow: none;
}
tooltip label {
  color: @window_fg_color;
}
