// Generated by theme-apply from tokens/midnight-blue.json via templates/fastfetch-static.tmpl. Edit the template, not this file.
// Midnight Blue fastfetch. Colours from ~/.config/theme/tokens/midnight-blue.json.
// Logo: ~/.config/fastfetch/logo-arch.txt -- the Arch mark as a dot matrix in the wallpaper's
// '.:+#@' ramp: $1-$4 = glow.peak/high/mid/base (top -> bottom, ordered-dither between bands),
// $5 = glow.dot for the dot field. Key icons follow the same ramp top -> bottom.
// Format-string colours: {##rrggbb} (double hash) is hex; {#rrggbb} is parsed as SGR and errors.
// {#separator} = display.color.separator, used to put key labels in text-muted after the icon.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/eclipse-logo.png",
    "width": 44,
    "color": {
      "1": "#86dcff",
      "2": "#4fc3f7",
      "3": "#5a9bff",
      "4": "#2f7cff",
      "5": "#1e5bcc"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "brightColor": false,
    "separator": "",
    "color": {
      "keys": "#6b7a9b",
      "title": "#e6ecfa",
      "output": "#a8b6d4",
      "separator": "#6b7a9b"
    },
    "key": {
      "width": 13
    },
    "bar": {
      "char": { "elapsed": "━", "total": "━" }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "bold_#e6ecfa",
        "at": "#6b7a9b",
        "host": "#e6ecfa"
      }
    },
    { "type": "custom", "format": "────────────────────────────────────────", "outputColor": "#2a3a5e" },
    { "type": "os",          "key": "󰖙{#separator}  os",       "keyColor": "#86dcff" },
    { "type": "kernel",      "key": "{#separator}  kernel",    "keyColor": "#86dcff" },
    { "type": "wm",          "key": "{#separator}  wm",        "keyColor": "#86dcff" },
    { "type": "terminal",    "key": "{#separator}  terminal",  "keyColor": "#4fc3f7" },
    { "type": "shell",       "key": "{#separator}  shell",     "keyColor": "#4fc3f7" },
    { "type": "uptime",      "key": "󰅐{#separator}  uptime",   "keyColor": "#4fc3f7" },
    { "type": "packages",    "key": "󰏖{#separator}  packages", "keyColor": "#5a9bff" },
    { "type": "display",     "key": "󰍹{#separator}  display",  "keyColor": "#5a9bff", "compactType": "original-with-refresh-rate" },
    { "type": "cpu",         "key": "{#separator}  cpu",       "keyColor": "#5a9bff" },
    { "type": "gpu",         "key": "󰢮{#separator}  gpu",      "keyColor": "#2f7cff" },
    { "type": "memory",      "key": "󰍛{#separator}  memory",   "keyColor": "#2f7cff" },
    { "type": "disk",        "key": "󰋊{#separator}  disk",     "keyColor": "#2f7cff", "folders": "/" },
    "break",
    { "type": "custom", "format": "{##1e5bcc}━━━━ {##2f7cff}━━━━ {##5a9bff}━━━━ {##4fc3f7}━━━━ {##86dcff}━━━━ {##3fd68c}━━━━ {##ffc857}━━━━ {##ff5c6e}━━━━" }
  ]
}
