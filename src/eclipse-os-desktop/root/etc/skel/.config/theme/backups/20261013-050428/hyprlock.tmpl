# Generated by theme-apply from tokens/midnight-blue.json via templates/hyprlock.tmpl. Edit the template, not this file.
# Midnight Blue — hyprlock, glass treatment (same language as the DMS bar):
# blurred current wallpaper, a glass password pill (surface @ 0.62 over the blur, 1px light
# hairline on its top edge, accent ring), Inter ExtraLight clock, date, user row, status row.
# Fail / caps-lock recolour the ring (error / warning). All text carries a soft shadow.
# Tokens: ~/.config/theme/tokens/midnight-blue.json -- hyprlock cannot read JSON, so theme-apply
# writes the values below. Launched directly by hypridle (not via loginctl); nothing here
# changes how it is started.
$mono = JetBrainsMono Nerd Font
$ui   = Inter

$text_primary   = rgb(E6ECFA)
$text_secondary = rgb(A8B6D4)
$text_muted     = rgb(6B7A9B)
$bg_base        = rgb(0A0F1E)
$surface_glass  = rgba(121b329e)          # surface @ 0.62: the bar's glass fill
$hairline       = rgba(e6ecfa38)     # text-primary @ 0.22: lit top edge
# accent ring = the same 3-stop 45deg gradient as the Hyprland active window border
$accent_ring    = rgba(5a9bffee) rgba(2f7cffee) rgba(1e5bccee) 45deg
$check_ring     = rgba(5a9bffff)    # checking
$error_ring     = rgba(ff5c6eff)            # wrong password
$warning_ring   = rgba(ffc857ff)          # caps lock on
$shadow         = rgba(050810cc)           # shadow @ 0.80

general {
    hide_cursor = true
    ignore_empty_input = true
    fail_timeout = 2500
}

animations {
    enabled = true
    bezier = ease, 0.25, 0.1, 0.25, 1
    animation = fadeIn, 1, 4, ease
    animation = fadeOut, 1, 4, ease
    animation = inputFieldDots, 1, 2, ease
}

# ── Background: the current wallpaper (symlink kept by ~/.local/bin/wallpaper), blurred
# like the glass it sits behind. Not `path = screenshot`: that leaks whatever was on screen.
background {
    monitor =
    path = ~/.cache/current-wallpaper-lock
    color = $bg_base
    blur_passes = 3
    blur_size = 6
    noise = 0.012
    contrast = 1.0
    brightness = 0.78
    vibrancy = 0.17
    vibrancy_darkness = 0.0
}

# ── Clock — Inter ExtraLight (font.clock-weight 200), text-primary
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = $text_primary
    font_size = 132
    font_family = $ui ExtraLight
    shadow_passes = 2
    shadow_size = 8
    shadow_color = $shadow
    position = 0, 170
    halign = center
    valign = center
}

# ── Date — text-secondary
label {
    monitor =
    text = cmd[update:60000] date +"%A, %-d %B"
    color = $text_secondary
    font_size = 17
    font_family = $ui
    shadow_passes = 2
    shadow_size = 5
    shadow_color = $shadow
    position = 0, 58
    halign = center
    valign = center
}

# ── Glass password pill: surface @ 0.62, pill radius, 2px accent ring.
# hyprlock has no focus/unfocus state (the field is always the focus target), so the
# accent ring is permanent; check / fail / caps lock swap it for accent-bright / error / warning.
input-field {
    monitor =
    size = 380, 56
    outline_thickness = 2
    rounding = -1
    inner_color = $surface_glass
    outer_color = $accent_ring
    check_color = $check_ring
    fail_color = $error_ring
    capslock_color = $warning_ring
    font_color = $text_primary
    font_family = $mono
    dots_size = 0.2
    dots_spacing = 0.45
    dots_center = true
    dots_rounding = -1
    fade_on_empty = false
    placeholder_text = <span foreground="##6B7A9B" font_family="Inter">Password</span>
    check_text = <span foreground="##A8B6D4" font_family="Inter">Checking…</span>
    fail_text = <span foreground="##FF5C6E" font_family="Inter">$PAMFAIL  ·  attempt $ATTEMPTS</span>
    shadow_passes = 2
    shadow_size = 10
    shadow_color = $shadow
    position = 0, -60
    halign = center
    valign = center
    zindex = 0
}

# ── 1px light hairline along the pill's top edge, just inside the ring (the glass "lit edge").
# Pill: 56 px tall centred at y -60, so its top edge is y -32 and the ring fills -32..-34.
shape {
    monitor =
    size = 300, 1
    color = $hairline
    rounding = 0
    border_size = 0
    position = 0, -35
    halign = center
    valign = center
    zindex = 1
}

# ── User row — text-muted, Arch glyph in the accent
label {
    monitor =
    text = <span foreground="##2F7CFF"></span>  $USER
    color = $text_muted
    font_size = 12
    font_family = $mono
    shadow_passes = 1
    shadow_size = 4
    shadow_color = $shadow
    position = 0, -122
    halign = center
    valign = center
}

# ── Status row (battery if present, network) — text-muted, bottom
label {
    monitor =
    text = cmd[update:30000] ~/.config/hypr/scripts/lock-status.sh
    color = $text_muted
    font_size = 11
    font_family = $mono
    shadow_passes = 1
    shadow_size = 4
    shadow_color = $shadow
    position = 0, 36
    halign = center
    valign = bottom
}
