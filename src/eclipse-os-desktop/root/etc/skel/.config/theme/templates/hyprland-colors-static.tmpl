#@ target: ~/.config/hypr/generated-colors.lua
#@ reload: hyprctl reload >/dev/null
#@ comment: --
-- Midnight Blue dynamic border colours, hue-clamped to the blue band.
-- Same structure as hyprland.lua's own border: a 3-stop gradient at 45deg that the
-- "borderangle" loop animation sweeps. At the token hue this reproduces
-- 5a9bff / 2f7cff / 1e5bcc exactly.
-- This is OUR file. It is NOT dms/colors.lua (that one stays unsourced).
hl.config({
    general = {
        col = {
            active_border   = { colors = { "rgba({{color.accent-bright|hexl}}ee)", "rgba({{color.accent|hexl}}ee)", "rgba({{color.accent-dim|hexl}}ee)" }, angle = 45 },
            -- Unfocused panes: LIGHT hairline (text-primary @ 0x24). A navy edge on navy glass
            -- reads as a smudge; a faint light rim reads as an edge. Mirrors hyprland.lua.
            inactive_border = "rgba({{color.text-primary|hexl}}24)",
        },
    },
})

-- Palette for hyprland.lua's hyprbars block (title bars). hyprland.lua falls back to
-- built-in Midnight Blue values if this file is missing or returns nothing.
return {
    surface        = "{{color.surface|hexl}}",
    text_secondary = "{{color.text-secondary|hexl}}",
    border_strong  = "{{color.border-strong|hexl}}",
    bg_base        = "{{color.bg-base|hexl}}",
    accent         = "{{color.accent|hexl}}",
    accent_bright  = "{{color.accent-bright|hexl}}",
    error          = "{{color.error|hexl}}",
}
