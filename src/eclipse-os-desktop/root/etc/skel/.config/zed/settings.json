// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// Midnight Blue: theme at ~/.config/zed/themes/midnight-blue.json (generated by
// `theme-apply` from ~/.config/theme/tokens/midnight-blue.json via
// ~/.config/theme/templates/zed-theme.tmpl). "Midnight Blue" is the glass
// variant (blurred; Hyprland supplies the blur), "Midnight Blue Opaque" the
// solid fallback. Fonts match the token fonts (Inter / JetBrainsMono Nerd Font);
// sizes 16/15 are Arthur's own choice and are kept on purpose.
{
  "cli_default_open_behavior": "existing_window",
  "ui_font_family": "Inter",
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "buffer_font_features": { "calt": true, "liga": true },
  // Ghostty uses JetBrainsMono + adjust-cell-height 6%; 1.4 matches that rhythm
  // (Zed's default "comfortable" is 1.618).
  "buffer_line_height": { "custom": 1.4 },
  // Tighter paddings in tab bar, title bar, lists and buttons.
  "unstable.ui_density": "compact",
  // Same caret as Ghostty (cursor-style = bar, cursor-style-blink = true).
  "cursor_shape": "bar",
  "cursor_blink": true,
  // Split panes: the pane you are not in fades by the token dim-inactive (0.1);
  // no accent frame around the active pane (accent is for focus rings only).
  "active_pane_modifiers": { "inactive_opacity": 0.9, "border_size": 0.0 },
  "tabs": { "file_icons": true, "git_status": true, "close_position": "right" },
  "project_panel": {
    "indent_size": 16,
    "entry_spacing": "standard",
    "indent_guides": { "show": "always" }
  },
  "scrollbar": { "show": "auto" },
  "gutter": { "min_line_number_digits": 3, "folds": true },
  // Type hints on a faint token-muted chip; parameter-name hints off (noise).
  "inlay_hints": { "enabled": true, "show_parameter_hints": false, "show_background": true },
  "title_bar": { "show_sign_in": false, "show_onboarding_banner": false, "show_user_picture": false },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_features": { "calt": true, "liga": true },
    "line_height": { "custom": 1.4 },
    "cursor_shape": "bar",
    "blinking": "on"
  },
  "theme": {
    "mode": "dark",
    "light": "Midnight Blue",
    "dark": "Midnight Blue"
  }
}
