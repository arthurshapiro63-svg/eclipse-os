// Generated by theme-apply from tokens/eclipse.json via templates/fastfetch-static.tmpl. Edit the template, not this file.
// Eclipse fastfetch. Colours from ~/.config/theme/tokens/eclipse.json.
// Logo: the Eclipse OS logo image (Arthur's eclipse photo), shown with the kitty graphics protocol
// (Ghostty, kitty). Old ASCII logo: ~/.config/fastfetch/logo-arch.txt -- the Arch mark as a dot matrix in the wallpaper's
// '.:+#@' ramp: $1-$4 = glow.peak/high/mid/base (top -> bottom, ordered-dither between bands),
// $5 = glow.dot for the dot field. Key icons follow the same ramp top -> bottom.
// Format-string colours: {##rrggbb} (double hash) is hex; {#rrggbb} is parsed as SGR and errors.
// {#separator} = display.color.separator, used to put key labels in text-muted after the icon.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/eclipse-logo.png",
    "width": 44,
    "color": {
      "1": "#fff6e4",
      "2": "#ffe6b8",
      "3": "#ffc94a",
      "4": "#e89b2a",
      "5": "#6e4f36"
    },
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "brightColor": false,
    "separator": "",
    "color": {
      "keys": "#6a665f",
      "title": "#eceae6",
      "output": "#9a958e",
      "separator": "#6a665f"
    },
    "key": {
      "width": 13
    },
    "bar": {
      "char": { "elapsed": "━", "total": "━" }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "bold_#eceae6",
        "at": "#6a665f",
        "host": "#eceae6"
      }
    },
    { "type": "custom", "format": "────────────────────────────────────────", "outputColor": "#34353a" },
    { "type": "os",          "key": "󰖙{#separator}  os",       "keyColor": "#fff6e4" },
    { "type": "kernel",      "key": "{#separator}  kernel",    "keyColor": "#fff6e4" },
    { "type": "wm",          "key": "{#separator}  wm",        "keyColor": "#fff6e4" },
    { "type": "terminal",    "key": "{#separator}  terminal",  "keyColor": "#ffe6b8" },
    { "type": "shell",       "key": "{#separator}  shell",     "keyColor": "#ffe6b8" },
    { "type": "uptime",      "key": "󰅐{#separator}  uptime",   "keyColor": "#ffe6b8" },
    { "type": "packages",    "key": "󰏖{#separator}  packages", "keyColor": "#ffc94a" },
    { "type": "display",     "key": "󰍹{#separator}  display",  "keyColor": "#ffc94a", "compactType": "original-with-refresh-rate" },
    { "type": "cpu",         "key": "{#separator}  cpu",       "keyColor": "#ffc94a" },
    { "type": "gpu",         "key": "󰢮{#separator}  gpu",      "keyColor": "#e89b2a" },
    { "type": "memory",      "key": "󰍛{#separator}  memory",   "keyColor": "#e89b2a" },
    { "type": "disk",        "key": "󰋊{#separator}  disk",     "keyColor": "#e89b2a", "folders": "/" },
    "break",
    { "type": "custom", "format": "{##6e4f36}━━━━ {##e89b2a}━━━━ {##ffc94a}━━━━ {##ffe6b8}━━━━ {##fff6e4}━━━━ {##3fd69a}━━━━ {##e0b040}━━━━ {##d42b2b}━━━━" }
  ]
}
