# Eclipse — generated from ~/.config/theme/tokens/eclipse.json
# Base, grey-blue text ramp, one saturated accent (#D08A4E).
# Glass alpha (background-opacity) lives in ~/.config/ghostty/config.

background = #0B0B0D
foreground = #9A958E

# The cursor is the ONE accented thing on this surface: the sun (Eclipse: golden corona).
cursor-color = #FFC94A
cursor-text  = #070708

# Selection: the accent's dim step, text lifts to text-primary.
selection-background = #6E4F36
selection-foreground = #ECEAE6

# Search (ctrl+shift+f): candidates in the raised surface, the current hit in warning.
search-background          = #2B2C31
search-foreground          = #ECEAE6
search-selected-background = #FFC94A
search-selected-foreground = #070708

# Splits: hairline divider, unfocused panes sink toward bg-sunken.
split-divider-color  = #34353A
unfocused-split-fill = #070708

# --- ANSI 0-7 (normal) ---
palette = 0=#17181B
