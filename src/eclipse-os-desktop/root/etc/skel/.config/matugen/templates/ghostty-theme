# Generated by matugen via ~/.local/bin/wallpaper-theme -- DO NOT EDIT.
# Midnight Blue (dynamic): same structure as the static render
# (~/.config/theme/templates/ghostty-theme.tmpl -> ./rice), every colour taken from the
# hue-clamped mb.* palette. At the token hue this is byte-for-byte the static palette.
# Glass alpha (background-opacity) lives in ~/.config/ghostty/config.

background = {{mb.bg_base}}
foreground = {{mb.text_secondary}}

# The cursor is the ONE accented thing on this surface.
cursor-color = {{mb.accent}}
cursor-text  = {{mb.bg_sunken}}

# Selection: the accent's dim step, text lifts to text-primary.
selection-background = {{mb.accent_dim}}
selection-foreground = {{mb.text_primary}}

# Search (ctrl+shift+f): candidates in the raised surface, the current hit in warning.
search-background          = {{mb.surface_hover}}
search-foreground          = {{mb.text_primary}}
search-selected-background = {{mb.warning}}
search-selected-foreground = {{mb.bg_sunken}}

# Splits: hairline divider, unfocused panes sink toward bg-sunken.
split-divider-color  = {{mb.border_subtle}}
unfocused-split-fill = {{mb.bg_sunken}}

# --- ANSI 0-7 (normal) ---
palette = 0={{mb.ansi_black}}
palette = 1={{mb.ansi_red}}
palette = 2={{mb.ansi_green}}
palette = 3={{mb.ansi_yellow}}
palette = 4={{mb.ansi_blue}}
palette = 5={{mb.ansi_magenta}}
palette = 6={{mb.ansi_cyan}}
palette = 7={{mb.ansi_white}}

# --- ANSI 8-15 (bright) ---
palette = 8={{mb.ansi_bright_black}}
palette = 9={{mb.ansi_bright_red}}
palette = 10={{mb.ansi_bright_green}}
palette = 11={{mb.ansi_bright_yellow}}
palette = 12={{mb.ansi_bright_blue}}
palette = 13={{mb.ansi_bright_magenta}}
palette = 14={{mb.ansi_bright_cyan}}
palette = 15={{mb.ansi_bright_white}}
