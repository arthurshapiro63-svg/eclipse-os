#!/usr/bin/env bash
# shell-switch arthur|dms   switch the running desktop shell AND make the choice persist.
# shell-switch status       show which shell runs and which one starts at login.
#
# - Stops the other shell by signalling its exact PIDs (never `dms kill`, never pkill by name:
#   DMS's UI is also a `qs` process, and so is arthur-shell).
# - Starts the requested shell and waits for its bar layer to appear. If it does not come up,
#   the previous shell is started again and nothing is persisted (you are never left shell-less).
# - Rewrites the single marked autostart line in ~/.config/hypr/hyprland.lua
#   ("-- shell-switch:exec"), after a backup and a Lua syntax check. Hyprland is never restarted
#   or reloaded (autostart lines only run at login).
set -uo pipefail
LUA="${SHELL_SWITCH_LUA:-$HOME/.config/hypr/hyprland.lua}"
MARK='-- shell-switch:exec'
EXEC_ARTHUR='hl.exec_cmd("qs -c arthur -n -d")'
EXEC_DMS='hl.exec_cmd("dms run")'
log() { printf 'shell-switch: %s\n' "$*"; }
die() { printf 'shell-switch: %s\n' "$*" >&2; exit 1; }

arthur_pids() { qs list --all 2>/dev/null | awk '/Process ID:/{p=$3} /Config path: .*\/quickshell\/arthur\/shell\.qml/{print p}'; }
dms_ui_pids() { qs list --all 2>/dev/null | awk '/Process ID:/{p=$3} /Config path: .*danklinux-shell\/.*shell\.qml/{print p}'; }
dms_backend_pids() { pgrep -x dms; }
running() {
    local a d; a=$(arthur_pids); d="$(dms_backend_pids) $(dms_ui_pids)"
    if [[ -n "$a" && -z "${d// /}" ]]; then echo arthur
    elif [[ -z "$a" && -n "${d// /}" ]]; then echo dms
    elif [[ -n "$a" ]]; then echo both
    else echo none; fi
}
persisted() {
    local line; line=$(grep -F -- "$MARK" "$LUA" | head -1)
    case "$line" in *'qs -c arthur'*) echo arthur ;; *'dms run'*) echo dms ;; *) echo unknown ;; esac
}
has_layer() { hyprctl layers 2>/dev/null | grep -q "namespace: $1"; }

stop_pids() {   # stop_pids <pid...> : TERM, wait up to 5 s, then KILL
    local p left
    [[ $# -gt 0 ]] || return 0
    kill -TERM "$@" 2>/dev/null
    for _ in $(seq 1 50); do
        left=""; for p in "$@"; do kill -0 "$p" 2>/dev/null && left+=" $p"; done
        [[ -z "$left" ]] && return 0; sleep 0.1
    done
    log "still running after 5 s, sending KILL to:$left"; kill -KILL $left 2>/dev/null; sleep 0.3
}
stop_shell() {
    case "$1" in
        arthur) stop_pids $(arthur_pids) ;;
        dms)    stop_pids $(dms_backend_pids); sleep 0.5; stop_pids $(dms_ui_pids) ;;
    esac
}
start_shell() {
    case "$1" in
        arthur) qs -c arthur -n -d >/dev/null 2>&1 ;;
        dms)    setsid -f dms run >/dev/null 2>&1 < /dev/null ;;
    esac
}
wait_up() {     # wait_up <shell> : bar layer visible within 15 s
    local ns; [[ "$1" == arthur ]] && ns=arthur-bar || ns='dms:bar'
    for _ in $(seq 1 150); do has_layer "$ns" && return 0; sleep 0.1; done
    return 1
}
persist() {
    local want line new tmp bak
    [[ "$1" == arthur ]] && want="$EXEC_ARTHUR" || want="$EXEC_DMS"
    line=$(grep -nF -- "$MARK" "$LUA" | head -1) || die "marker '$MARK' not found in $LUA"
    [[ $(grep -cF -- "$MARK" "$LUA") -eq 1 ]] || die "marker appears more than once in $LUA; not touching it"
    [[ "$(persisted)" == "$1" ]] && { log "login already starts $1"; return 0; }
    bak="$LUA.bak-$(date +%Y%m%d-%H%M%S)"; cp -p "$LUA" "$bak"
    tmp=$(mktemp); python3 - "$LUA" "$MARK" "$want" > "$tmp" <<'PY' || { rm -f "$tmp"; die "rewrite failed"; }
import re, sys
path, mark, want = sys.argv[1:]
out = []
for l in open(path).read().split('\n'):
    if mark in l:
        indent = re.match(r'\s*', l).group(0)
        l = f'{indent}{want}   {mark} (this line is rewritten by ~/.local/bin/shell-switch)'
    out.append(l)
sys.stdout.write('\n'.join(out))
PY
    if ! luac -p "$tmp" 2>/dev/null; then rm -f "$tmp"; die "new hyprland.lua failed the Lua syntax check; unchanged (backup $bak)"; fi
    cat "$tmp" > "$LUA"; rm -f "$tmp"
    log "login now starts $1 (backup: $bak)"
}

target="${1:-status}"
case "$target" in
    status)
        echo "running: $(running)"; echo "starts at login: $(persisted)"; exit 0 ;;
    arthur|dms) ;;
    *) echo "usage: shell-switch arthur|dms|status" >&2; exit 2 ;;
esac
other=$([[ "$target" == arthur ]] && echo dms || echo arthur)
now=$(running)
log "running now: $now -> switching to $target"

if [[ "$target" == arthur ]] && grep -q '"screens": *\[ *"' "$HOME/.config/quickshell/arthur/settings.json" 2>/dev/null; then
    log "warning: settings.json dev.screens is set, so arthur-shell draws only on those screens"
fi

stop_shell "$other"
# arthur-shell may already run in development mode next to DMS: restart it so it takes over the
# notification daemon and tray watcher names that DMS just released.
[[ "$target" == arthur ]] && stop_shell arthur
[[ "$target" == dms ]] && [[ -n "$(dms_backend_pids)" ]] && stop_shell dms
sleep 0.4
start_shell "$target"
if ! wait_up "$target"; then
    log "$target did not come up within 15 s; starting $other again"
    stop_shell "$target"; start_shell "$other"
    wait_up "$other" && log "$other is back" || log "WARNING: $other did not come back either; run: $([[ $other == dms ]] && echo 'setsid -f dms run' || echo 'qs -c arthur -n -d')"
    exit 1
fi
log "$target is up"
persist "$target"
echo "running: $(running)"; echo "starts at login: $(persisted)"
