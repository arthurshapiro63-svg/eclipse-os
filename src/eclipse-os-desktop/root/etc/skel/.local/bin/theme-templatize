#!/usr/bin/env python3
"""theme-templatize <source-file> <template-name> [--comment X] [--reload CMD] [--prefer ansi]
Turn a config that was hand-built from the Midnight Blue tokens into a theme template:
every token colour is replaced by its placeholder (case preserved), then the template is
rendered back with midnight-blue and must reproduce the source BYTE-FOR-BYTE, or nothing is written."""
import json, re, sys, subprocess
from pathlib import Path
a=sys.argv[1:]
if len(a)<2: sys.exit(__doc__)
src, name = Path(a[0]).expanduser(), a[1]
opt=lambda k,d=None: a[a.index(k)+1] if k in a else d
comment, reload, prefer = opt('--comment','#'), opt('--reload'), opt('--prefer','color')
tok=json.loads((Path.home()/'.config/theme/tokens/midnight-blue.json').read_text())
rev={}
order=['ansi','color'] if prefer=='ansi' else ['color','ansi']
for sec in reversed(order):                         # later sections win -> preferred section wins
    for k,v in tok[sec].items(): rev[v.lstrip('#').lower()]=f'{sec}.{k}'
text=src.read_text()
# strip a previous theme-apply stamp line if present
text=re.sub(r'^.*Generated by theme-apply from tokens/.*\n','',text,count=1)
def ph(h):
    path=rev.get(h.lower())
    if not path: return None
    f='hexl' if (h==h.lower() and h!=h.upper()) else 'hex'
    return '{{'+path+'|'+f+'}}'
def sub(m):
    pre,h=m.group(1),m.group(2)
    if len(h)==6:
        p=ph(h); return pre+p if p else m.group(0)
    # 8 digits: Qt-style AARRGGBB (after '#') or Hyprland/hyprlock RRGGBBAA
    tail,head=ph(h[2:]),ph(h[:6])
    if pre=='#' and tail: return pre+h[:2]+tail
    if head: return pre+head+h[6:]
    if tail: return pre+h[:2]+tail
    return m.group(0)
body=re.sub(r'(#?)(?<![0-9A-Fa-f])([0-9A-Fa-f]{8}|[0-9A-Fa-f]{6})(?![0-9A-Fa-f])',sub,text)
# decimal rgb()/rgba() triples, e.g. Zen CSS "rgba(18, 27, 50, 0.72)"
def dsub(m):
    pre,r,s1,g,s2,b=m.groups()
    h='%02x%02x%02x'%(int(r),int(g),int(b)); path=rev.get(h)
    if not path or s1!=s2 or s1.strip()!=',': return m.group(0)
    f='rgbs' if s1==', ' else ('rgb' if s1==',' else None)
    return pre+'{{'+path+'|'+f+'}}' if f else m.group(0)
body=re.sub(r'(rgba?\(\s*)(\d{1,3})(\s*,\s*)(\d{1,3})(\s*,\s*)(\d{1,3})(?=\s*[,)])',dsub,body)
# the '#' stays literal before |hex/|hexl, so rendering reproduces '#RRGGBB' exactly
hdr=f'#@ target: {src}\n#@ comment: {comment}\n'+(f'#@ reload: {reload}\n' if reload else '')
tpl=Path.home()/'.config/theme/templates'/f'{name}.tmpl'
n=len(re.findall(r'\{\{',body))
# round-trip proof using the real engine's renderer
sys.path.insert(0,str(Path.home()/'.local/bin'))
import importlib.machinery, importlib.util
loader=importlib.machinery.SourceFileLoader('ta',str(Path.home()/'.local/bin/theme-apply'))
ta=importlib.util.module_from_spec(importlib.util.spec_from_loader('ta',loader)); loader.exec_module(ta)
out=ta.render(body,tok,name)
if out!=text:
    import difflib; sys.stderr.writelines(list(difflib.unified_diff(text.splitlines(1),out.splitlines(1),'source','rendered'))[:20])
    sys.exit(f'ROUND-TRIP FAILED for {src}; template NOT written')
tpl.write_text(hdr+body)
print(f'{name}.tmpl: {n} placeholders, round-trip exact ({len(text)} bytes)')
