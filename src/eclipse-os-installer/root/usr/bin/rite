#!/usr/bin/env python3
import os, sys
for _c in (os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."), "/usr/lib/arclight/installer"):
    if os.path.isdir(os.path.join(_c, "arclight_installer")):
        sys.path.insert(0, os.path.abspath(_c)); break
for _c in (os.path.join(os.path.dirname(os.path.realpath(__file__)), "../../src"), "/usr/lib/arclight"):
    if os.path.isdir(os.path.join(_c, "arclight")):
        sys.path.insert(0, os.path.abspath(_c)); break
from arclight_installer.rite import main
sys.exit(main())
