#!/bin/bash
# Eclipse OS live USB: make the passwordless "eclipse" user with the default Eclipse home.
# Runs once per boot (the live system lives in RAM). The installer removes this file.
set -u
U=eclipse
id "$U" >/dev/null 2>&1 && exit 0
systemd-sysusers
# the live USB stays passwordless (it has no password to ask for); the installer turns this off again
PYTHONPATH=/usr/lib/arclight python3 -c 'from arclight.system import sysconf; sysconf.set_nopasswd(True)' || true
groups=()
for g in wheel arclight video audio input storage uucp network; do getent group "$g" >/dev/null && groups+=("$g"); done
useradd -M -u 1000 -U -G "$(IFS=,; echo "${groups[*]}")" -s /bin/bash -c "Eclipse" "$U"
passwd -d "$U" >/dev/null
skel=/usr/share/arclight/skel; [ -d "$skel" ] || skel=/etc/skel
cp -aT "$skel" "/home/$U"
chown -R "$U:$U" "/home/$U"
# setpriv, not runuser: runuser opens a PAM login session, and pam_systemd then waits for user@1000.service,
# which is ordered after systemd-user-sessions.service, which waits for this unit: a 2-minute deadlock that
# only ended on a timeout. firstrun needs no login session (it worked after that timeout without one).
setpriv --reuid "$U" --regid "$U" --init-groups --reset-env \
    arclight-firstrun --home "/home/$U" --offline --force || true
exit 0
